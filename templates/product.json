    "collapsible_content_fiKqXD": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_bXcQKL": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What’s included in the box?",
            "icon": "none",
            "row_content": "<p>Every product page lists what’s included (car seat shell, base, manual, etc.). If packaging is imperfect, accessories may vary - check the “Includes” section and condition notes.</p>",
            "page": ""
          }
        },
        "collapsible_row_WQUArC": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the warranty for this item?",
            "icon": "none",
            "row_content": "<p>If it’s new or open box, manufacturer warranty may apply - the product description will note this. For gently used/floor models, warranty may not apply, but we test functionality before listing.</p>",
            "page": ""
          }
        },
        "collapsible_row_Jij8Hh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How can I check compatibility (e.g., car seat with stroller)?",
            "icon": "none",
            "row_content": "<p>Compatibility info is usually listed on the product page (brands/adapter required). For complete accuracy, please also check the manufacturer’s website.</p>",
            "page": ""
          }
        },
        "collapsible_row_ni6xdw": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if an item has cosmetic wear or missing packaging?",
            "icon": "none",
            "row_content": "<p>Any wear is noted on the product page. Most items ship in the original box; some Floor Model/Gently Used items may not. Check the first line of the description for packaging details.</p>",
            "page": ""
          }
        },
        "collapsible_row_Brb7jV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I cancel or change my order?",
            "icon": "none",
            "row_content": "<p>Once the order has shipped, we cannot cancel or change the address. If you reject a shipment delivery without prior approval, shipping fees may be deducted at refund.</p>",
            "page": ""
          }
        },
        "collapsible_row_YXTkNV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long will shipping take once I’ve ordered?",
            "icon": "none",
            "row_content": "<p>Orders usually ship within 3–4 business days. You’ll receive tracking info and typical delivery is 3–7 business days within the U.S.</p>",
            "page": ""
          }
        },
        "collapsible_row_i6xNxp": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return/refund process?",
            "icon": "none",
            "row_content": "<p>Contact us to initiate a return. We’ll send a shipping label. Items must be returned within 4 days of receiving the label and in the same condition. Refunds processed after inspection (can take up to 7 days).</p>",
            "page": ""
          }
        },
        "collapsible_row_Lq6hxB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does the price reflect the condition?",
            "icon": "none",
            "row_content": "<p>Yes - condition is a key factor in pricing. The listing will show the condition, pricing tier, and corresponding discount compared to retail.</p>",
            "page": ""
          }
        },
        "collapsible_row_XhwR8i": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are there any hidden fees (shipping, duty, etc.)?",
            "icon": "none",
            "row_content": "<p>Shipping is free on orders over $75 in the U.S. Orders under $75 may incur a shipping fee. There are no hidden customs or duties for U.S. domestic shipments.</p>",
            "page": ""
          }
        },
        "collapsible_row_D6zhbb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What should I check when the item arrives?",
            "icon": "none",
            "row_content": "<p>On delivery, check that you received all parts/accessories listed in the product description, inspect for any damage or discrepancies, then contact us promptly if something is missing or not as described.</p>",
            "page": ""
          }
        }
      },
