    "kidsy_static_customer_testimonial_HrjNyL": {
      "type": "Kidsy-static-customer-testimonial",
      "blocks": {
        "testimonial_F8fPPT": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "Kidsy had exactly the baby/pet gates we…",
            "text": "<p>Kidsy had exactly the baby/pet gates we needed...good price...good shipping...good items. If you have children or know someone who has children...this site is a keeper! They get 10 stars!!</p>",
            "author": "Eileen W",
            "verify_buyer": true
          }
        },
        "testimonial_PRaHkP": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "Quick response",
            "text": "<p>Ordered a gate prior to this one, UPS lost it on route. I reached out to Kidsy via email and they secured a refund from UPS. Was hesitant to order again, but I couldn't find the gate at a more reasonable price. 2nd order arrived with no issues. Gate is sturdy and the dog (Husky) hasn't gotten through it (he's an escape artist). Quick delivery from start to finish.</p>",
            "author": "Shelli F.",
            "verify_buyer": true
          }
        },
        "testimonial_JqMFad": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "Great, trustworthy experience",
            "text": "<p>Great deals, easy checkout with lots of payment options, shipped very quickly, and everything was packed well and looked exactly as it was described! I didn't end up needing any intervention with my shipping experience but appreciate the option to cover lost packages for a minimal fee, especially as we get into the late and lost package holiday season. I'll definitely be getting more of my baby gear from Kidsy.</p>",
            "author": "Lydia M",
            "verify_buyer": true
          }
        },
        "testimonial_GGrqQP": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "The best prices going and shipping is…",
            "text": "<p>The best prices going and shipping is fast.</p>",
            "author": "Tanya and Gina Hill",
            "verify_buyer": true
          }
        },
        "testimonial_DQhWEr": {
          "type": "testimonial",
          "settings": {
