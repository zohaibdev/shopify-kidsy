        },
        "collapsible_row_ppVzq6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I cancel or change my order?",
            "icon": "none",
            "row_content": "<p>Once the order has shipped, we cannot cancel or change the address. If you reject a shipment delivery without prior approval, shipping fees may be deducted at refund.</p>",
            "page": ""
          }
        },
        "collapsible_row_nX3aQy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long will shipping take once I’ve ordered?",
            "icon": "none",
            "row_content": "<p>Orders usually ship within 3–4 business days. You’ll receive tracking info and typical delivery is 3–7 business days within the U.S.</p>",
            "page": ""
