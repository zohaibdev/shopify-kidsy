    "collapsible_content_JEX3xa": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_UcaAXG": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is Kidsy?",
            "icon": "none",
            "row_content": "<p>We’re a curated destination for premium baby & kids’ gear offered at steep discounts — including new-in-box, open-box, and gently used items — all carefully inspected for safety and function.</p>",
            "page": ""
          }
        },
        "collapsible_row_WJBAb8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is Kidsy a legit website?",
            "icon": "none",
            "row_content": "<p><strong>Yes — Kidsy is a 100% legitimate business</strong> specializing in open-box, overstock, and returned baby gear from major retailers and trusted manufacturers. Every item is inspected for safety, function, and completeness before it’s listed. Thousands of families shop Kidsy each month for 20–60% off trusted brands with full transparency on condition and packaging.</p>",
            "page": ""
          }
        },
        "collapsible_row_EHwch6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are all your products authentic and safe?",
            "icon": "none",
            "row_content": "<p>Yes - every item is 100% authentic, comes from trusted manufacturers or major retailers, and is inspected for safety and performance before listing.</p>",
            "page": ""
          }
        },
        "collapsible_row_EYFidG": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What do you mean by “open-box”, “floor model”, and “gently used”?",
            "icon": "none",
            "row_content": "<p>We use consistent condition labels so you know exactly what to expect:</p><ul><li><strong>Factory Sealed:</strong> Brand new, unopened, untouched.</li><li><strong>New Overstock / Open Box / Imperfect Box: </strong>Brand-new item. The box was opened or has cosmetic damage (e.g., dented corners, torn retail labels, or re-taped packaging).</li><li><strong>Floor Model:</strong> Fully functional item with possible minor cosmetic wear from handling. Original packaging may be missing.</li><li><strong>Gently Used:</strong> Light cosmetic wear, fully functional, carefully inspected. Typically no manufacturer's warranty.</li></ul>",
            "page": ""
          }
        },
        "collapsible_row_MtNpLz": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you ship from the U.S. and how fast will my order arrive?",
            "icon": "none",
            "row_content": "<p>Yes, we are headquartered in Chicago and fulfill from our U.S.‐based warehouses in the Midwest. Orders ship within 2-3 business days and typically arrive within 3–7 business days depending on location.</p>",
            "page": ""
          }
        },
        "collapsible_row_WkxRzR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "none",
            "row_content": "<p>Returns are accepted within 14 days if an item arrives damaged or significantly different from its description. Items must be returned in the same condition using our provided label. Refunds are processed after inspection.</p>",
            "page": ""
          }
        },
        "collapsible_row_ig8kbq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are the warranties still valid on discounted items?",
            "icon": "none",
            "row_content": "<p>For “New in Box” and “Open Box” items, manufacturer warranties may apply. For “Floor Model” and “Gently Used” items, warranties typically do not apply. Because warranty rules vary by brand, we always recommend confirming with the manufacturer directly.</p>",
            "page": ""
          }
        },
        "collapsible_row_cPVmtH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why are your prices so much lower than retail?",
            "icon": "none",
            "row_content": "<p>It is because we source overstock, open‐box returns, and floor models that we’re able to pass big savings on to you - all the while maintaining safety and quality standards. </p>",
            "page": ""
          }
        },
        "collapsible_row_UfKqwx": {
          "type": "collapsible_row",
          "settings": {
