        "testimonial_hw9pAB": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "My item shipped very quickly and I…",
            "text": "<p>My item shipped very quickly and I received it about 3 days after I ordered it! It came in an extra protected box as well! Very pleased with my purchase!</p>",
