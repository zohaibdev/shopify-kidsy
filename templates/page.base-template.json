        },
        "testimonial_MbPEcH": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "Kidsy Customer Service Review",
            "text": "<p>Kidsy had a great selection of deeply discounted baby gates. Unfortunately, there was a piece missing when I received my package. I didn't realize it until after the 14 day return/exchange window. But I reached out, and they were willing to send me the piece anyway at no extra charge. I really appreciated the customer service.</p>",
            "author": "Josh Radcliff",
            "verify_buyer": true
          }
        },
