        "testimonial_QyLeMH": {
          "type": "testimonial",
          "settings": {
            "review_star": 5,
            "review_title": "The products were very good",
            "text": "<p>The products were very good. More than I’d expected them to be. The color of the diaper bag is beautiful and I know my daughter in love will be happy with it.</p>",
