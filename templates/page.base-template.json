    "collapsible_content_cznxjM": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_FcxYgt": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is Kidsy?",
            "icon": "none",
            "row_content": "<p>We’re a curated destination for premium baby & kids’ gear offered at steep discounts — including new-in-box, open-box, and gently used items — all carefully inspected for safety and function.</p>",
            "page": ""
          }
        },
        "collapsible_row_npgrMi": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is Kidsy a legit website?",
            "icon": "none",
            "row_content": "<p><strong>Yes — Kidsy is a 100% legitimate business</strong> specializing in open-box, overstock, and returned baby gear from major retailers and trusted manufacturers. Every item is inspected for safety, function, and completeness before it’s listed. Thousands of families shop Kidsy each month for 20–60% off trusted brands with full transparency on condition and packaging.</p>",
            "page": ""
          }
        },
        "collapsible_row_Cdkhi4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are all your products authentic and safe?",
            "icon": "none",
            "row_content": "<p>Yes - every item is 100% authentic, comes from trusted manufacturers or major retailers, and is inspected for safety and performance before listing.</p>",
            "page": ""
          }
        },
        "collapsible_row_wT63ch": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What do you mean by “open-box”, “floor model”, and “gently used”?",
            "icon": "none",
            "row_content": "<p>We use consistent condition labels so you know exactly what to expect:</p><ul><li><strong>Factory Sealed:</strong> Brand new, unopened, untouched.</li><li><strong>New Overstock / Open Box / Imperfect Box: </strong>Brand-new item. The box was opened or has cosmetic damage (e.g., dented corners, torn retail labels, or re-taped packaging).</li><li><strong>Floor Model:</strong> Fully functional, may have minor scuffs or handling wear. Original packaging may be missing.</li><li><strong>Gently Used:</strong> Light cosmetic wear, fully functional, carefully inspected. Typically no manufacturer's warranty.</li></ul>",
            "page": ""
          }
        },
        "collapsible_row_jM9BQB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you ship from the U.S. and how fast will my order arrive?",
            "icon": "none",
            "row_content": "<p>Yes, we are headquartered in Chicago and fulfill from our U.S.‐based warehouses in the Midwest. Orders ship within 2-3 business days and typically arrive within 3–7 business days depending on location.</p>",
            "page": ""
          }
        },
        "collapsible_row_XArBWn": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "none",
            "row_content": "<p>Returns are accepted within 14 days if an item arrives damaged or significantly different from its description. Items must be returned in the same condition using our provided label. Refunds are processed after inspection.</p>",
            "page": ""
          }
        },
        "collapsible_row_Xm4QUi": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are the warranties still valid on discounted items?",
            "icon": "none",
            "row_content": "<p>For “New in Box” and “Open Box” items, manufacturer warranties may apply. For “Floor Model” and “Gently Used” items, warranties typically do not apply. Because warranty rules vary by brand, we always recommend confirming with the manufacturer directly.</p>",
            "page": ""
          }
        },
        "collapsible_row_PcFY76": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why are your prices so much lower than retail?",
            "icon": "none",
            "row_content": "<p>It is because we source overstock, open‐box returns, and floor models that we’re able to pass big savings on to you - all the while maintaining safety and quality standards. </p>",
            "page": ""
          }
        },
        "collapsible_row_EY9DJx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How often is your inventory restocked?",
            "icon": "none",
            "row_content": "<p>Hundreds of new products are listed daily. Because we offer incredible deals on overstock and open-box quantities, we recommend acting fast when you see something you like.</p>",
            "page": ""
          }
        },
        "collapsible_row_dcGCxR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes Kidsy different from other companies or marketplaces?",
            "icon": "none",
            "row_content": "<p>Unlike peer-to-peer resale platforms, we partner directly with premium brands and large retailers to resell excess inventory and open-box products from the best brands at incredible prices. We inspect and grade every item, and clearly label the product condition. We are not an open marketplace of random sellers.</p>",
            "page": ""
          }
        },
        "collapsible_row_eYHQbg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How can I contact you if I have questions or issues?",
            "icon": "none",
            "row_content": "<p>Email: <a href=\"mailto:hello@kidsy.co\"><span style=\"text-decoration:underline\"><strong>hello@kidsy.co</strong></span></a></p><p>Phone: <a href=\"tel:3129648348\" title=\"tel:3129648348\"><strong>(312) 964-8348</strong></a></p><p>Live chat: available on our website</p><p>Customer service hours: <strong>Mon–Fri, 9am–5pm CST</strong></p>",
            "page": ""
          }
        }
      },
