    "faq_CFrKb8": {
      "type": "faq",
      "blocks": {
        "faq_YABQQh": {
          "type": "faq",
          "settings": {
            "question": "Is Kidsy Points free to join?",
            "answer": "<p>Yes, joining Kidsy Points is completely free. No credit card or membership fees required, and you'll earn 100 bonus points the moment your account is confirmed.</p>",
            "open_by_default": false
          }
        },
        "faq_HyFb3x": {
          "type": "faq",
          "settings": {
            "question": "How do I earn points?",
            "answer": "<p>You earn points for shopping (per dollar spent), writing approved reviews, sharing on social, referring friends, and on your birthday. See the rewards grid above for the full list.</p>",
            "open_by_default": false
          }
        },
        "faq_bi86Ni": {
          "type": "faq",
          "settings": {
            "question": "When do my points expire?",
            "answer": "<p>Your points expire after <strong>3 months of inactivity</strong>, so don’t let your savings sit too long. Earn or redeem points to keep your balance active.</p>",
            "open_by_default": false
          }
        },
        "faq_dkQQng": {
          "type": "faq",
          "settings": {
            "question": "Can I combine points with a promo code?",
            "answer": "<p>It depends on the discount. Kidsy Points rewards may be combined with eligible discounts when allowed at checkout. Some promo codes or offers may not stack.</p>",
            "open_by_default": false
          }
        },
        "faq_3XEqyM": {
          "type": "faq",
          "settings": {
            "question": "What happens if I return an order?",
            "answer": "<p>If you return an order, the points earned on that purchase will be deducted from your balance. Points used at checkout will be restored if your refund is processed.</p>",
            "open_by_default": false
          }
        },
        "faq_CnBbNM": {
          "type": "faq",
          "settings": {
            "question": "How Do I Redeem My Points?",
            "answer": "<p>Log in to your Kidsy account and open the Kidsy Points panel. Go to <strong>Ways to redeem</strong>, choose your reward, then copy or apply your discount code at checkout. Every <strong>100 points = $1 off</strong>.</p>",
            "open_by_default": false
          }
        },
        "faq_bgK4F7": {
          "type": "faq",
          "settings": {
            "question": "Where Can I See My Points And Rewards?",
            "answer": "<p>Open the <a href=\"#smile-home\" title=\"#smile-home\">Kidsy Points panel</a> anytime to see your points balance, available rewards, ways to earn, and past activity.</p>",
            "open_by_default": false
          }
        }
