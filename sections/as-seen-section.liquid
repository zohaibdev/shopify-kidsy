<style>
.as-seen-section .container { max-width: 1380px; padding: 0px; margin: 0px auto; } .as-seen-section .as-seen-wrapper { padding: 7px 0px 28px; background: #fffbf7; } .as-seen-section .heading-wrap h2 { font-family: "Poppins", sans-serif; margin: 0px; font-size: 48px; font-weight: 500; line-height: 1.2; letter-spacing: 0; color: #000000; padding-bottom: 10px; } .as-seen-section .heading-wrap h2 p { margin: 0px; } .as-seen-section .block-wrapper { display: flex; flex-wrap: nowrap; overflow: hidden; gap: 33px; } .as-seen-section .image-text-wrapper { display: flex; justify-content: center; text-align: center; gap: 60px; animation: slide-left 70s linear infinite; padding: 41px 0px 46px; } .as-seen-section .image-wrap { height: 88px; display: flex; padding-bottom: 7px; align-items: center; justify-content: center; } .as-seen-section .text-wrap p { font-family: "Poppins", sans-serif; font-size: 14px; font-weight: 400; line-height: 1.3; letter-spacing: 0; color: #000000; margin: 0; } .as-seen-wrapper .image-text-wrap { width: 190px; } @keyframes slide-left { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-100%, 0, 0); } } @media only screen and (max-width:768px) { .as-seen-section .as-seen-wrapper { padding: 20px 0px 0px; } .as-seen-section .text-wrap p { font-size: 10px; } .as-seen-section .heading-wrap h2 { font-size: 24px; text-align: center; line-height: 1; padding-bottom: 19px; border-bottom: 0.62px solid #000000; } .as-seen-section .block-wrapper { display: flex; flex-wrap: nowrap; overflow: hidden; gap:21px; } .as-seen-section .image-text-wrapper { gap: 21px; padding: 26px 0px 23px; } .as-seen-section .image-wrap { padding-bottom: 4px; height: 65px; } .as-seen-section .image-wrap img { max-width: 140px; } }
</style>
<section class="as-seen-section">
  <div class="container">
    <div class="as-seen-wrapper">
      <div class="heading-wrap">
        <h2>{{ section.settings.heading_text }}</h2>
      </div>
      <div class="block-wrapper">
        <div class="image-text-wrapper">
          {% for block in section.blocks %}
            <div class="image-text-wrap">
              <div class="image-wrap">
                <img
                  src="{{ block.settings.svg_image| image_url }}"
                  alt="{{ block.settings.svg_image }}"
                  width="{{block.settings.svg_image }}"
                  height="{{ block.settings.svg_image }}"
                  loading="lazy"
                >
              </div>
              <div class="text-wrap">{{ block.settings.text }}</div>
            </div>
          {% endfor %}
        </div>
        <div class="image-text-wrapper">
          {% for block in section.blocks %}
            <div class="image-text-wrap">
              <div class="image-wrap">
                <img
                  src="{{ block.settings.svg_image| image_url }}"
                  alt="{{ block.settings.svg_image }}"
                  width="{{block.settings.svg_image }}"
                  height="{{ block.settings.svg_image }}"
                  loading="lazy"
                >
              </div>
              <div class="text-wrap">{{ block.settings.text }}</div>
            </div>
          {% endfor %}
        </div>
        <div class="image-text-wrapper">
          {% for block in section.blocks %}
            <div class="image-text-wrap">
              <div class="image-wrap">
                <img
                  src="{{ block.settings.svg_image| image_url }}"
                  alt="{{ block.settings.svg_image }}"
                  width="{{block.settings.svg_image }}"
                  height="{{ block.settings.svg_image }}"
                  loading="lazy"
                >
              </div>
              <div class="text-wrap">{{ block.settings.text }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "As Seen Section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading_text",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "image_picker",
          "id": "svg_image",
          "label": "SVG Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Paragraph"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen Section"
    }
  ]
}
{% endschema %}