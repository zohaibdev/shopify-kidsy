{% comment %}
============================================================
Section: Every Action Earns
------------------------------------------------------------
Reward steps grid section matching Figma design:
• Centered header with title + subtitle (646px max width)
• Grid of step cards (4 columns desktop, responsive)
• Each card: gradient circle icon + title + description + orange tag

Cards are managed as section blocks so merchants can add,
remove, reorder, and edit any card from the theme editor.
All text, colors, icons, and layout settings are dynamic.
============================================================
{% endcomment %}

{%- liquid
assign s = section.settings
assign sec_id = 'kidsy-earns-' | append: section.id
assign cols = s.columns_desktop | default: 4
-%}
<link rel="preload" href="{{ 'custom.css' | asset_url }}" as="style">
<style>
#{{ sec_id }} {
--bg:        {{ s.color_bg        | default: '#FFF4E1' }};
--card-bg:   {{ s.color_card      | default: '#FFFFFF' }};
--text:      {{ s.color_text      | default: '#341300' }};
--tag-bg:    {{ s.color_tag       | default: '#F45901' }};
--tag-text:  {{ s.color_tag_text  | default: '#FFFFFF' }};
--icon-from: {{ s.color_icon_from | default: '#F8B086' }};
--icon-to:   {{ s.color_icon_to   | default: 'rgba(255,223,168,0)' }};
}

#{{ sec_id }} {
background: var(--bg);
padding: {{ s.padding_top | default: 50 }}px 0 {{ s.padding_bottom | default: 50 }}px;
font-family: "Roobert TRIAL", sans-serif;
color: var(--text);
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
}

#{{ sec_id }} img { display: block; max-width: 100%; }

#{{ sec_id }} .ke__inner {
display: flex;
flex-direction: column;
gap: 20px;
}

/* ============================================================
HEADER — 646px max, centered
============================================================ */
#{{ sec_id }} .ke__header {
max-width: 646px;
margin: 0 auto;
display: flex;
flex-direction: column;
gap: 16px;
align-items: center;
text-align: center;
padding: 0 16px;
}

#{{ sec_id }} .ke__title {
margin: 0;
color: var(--text);
font-size: 32px;
font-weight: 600;
text-transform: capitalize;
line-height: 1.1;
letter-spacing: 0;
}

#{{ sec_id }} .ke__subtitle {
margin: 0;
color: var(--text);
font-size: 16px;
font-weight: 400;
line-height: 1.5;
text-transform: capitalize;
}

/* ============================================================
CARD GRID — 4 columns desktop, 24px gap (Figma exact)
============================================================ */
#{{ sec_id }} .ke__grid {
display: grid;
grid-template-columns: repeat({{ cols }}, 1fr);
gap: 24px;
width: 100%;
}

#{{ sec_id }} .ke__card {
position: relative;
background: var(--card-bg);
border-radius: 16px;
padding: 20px;
display: flex;
flex-direction: column;
align-items: center;
gap: 10px;
transition: transform .2s ease, box-shadow .2s ease;
}

/* Full-card clickable link */
#{{ sec_id }} .ke__card-link {
display: block;
position: absolute;
inset: 0;
z-index: 2;
border-radius: 16px;
pointer-events: auto;
font-size: 0;
line-height: 0;
color: transparent;
text-decoration: none;
text-indent: -9999px;
overflow: hidden;
}
#{{ sec_id }} .ke__card:hover {
transform: translateY(-3px);
box-shadow: 0 14px 30px -12px rgba(52,19,0,.18);
}

/* Gradient circle icon — 48px, peach top → transparent bottom */
#{{ sec_id }} .ke__icon {
width: 48px;
height: 48px;
border-radius: 40px;
background:linear-gradient(180deg, #F8B086 0%, rgba(255, 223, 168, 0.00) 100%);
display: inline-flex;
align-items: center;
justify-content: center;
overflow: hidden;
flex-shrink: 0;
}
#{{ sec_id }} .ke__icon img,
#{{ sec_id }} .ke__icon svg {
width: 24px;
height: 24px;
object-fit: contain;
color: var(--text);
}
/* Larger icon for cards that need it (e.g. birthday cake) */
#{{ sec_id }} .ke__icon--lg img,
#{{ sec_id }} .ke__icon--lg svg {
width: 28px;
height: 28px;
}

/* Card body — title, description, tag */
#{{ sec_id }} .ke__body {
width: 100%;
max-width: 280px;
display: flex;
flex-direction: column;
gap: 5px;
align-items: center;
text-align: center;
}
#{{ sec_id }} .ke__card-title {
margin: 0;
color: var(--text);
font-size: 16px;
font-weight: 600;
text-transform: capitalize;
line-height: 1.2;
}
#{{ sec_id }} .ke__card-desc {
margin: 0;
color: var(--text);
font-size: 16px;
font-weight: 400;
text-transform: capitalize;
line-height: 1.3;
}
#{{ sec_id }} .ke__card-tag {
background: var(--tag-bg);
color: var(--tag-text);
border-radius: 4px;
padding: 5px 10px;
font-size: 12px;
font-weight: 600;
letter-spacing: 0.24px;
text-transform: uppercase;
line-height: 1;
display: inline-flex;
align-items: center;
min-height:25px;
}

/* ============================================================
RESPONSIVE — graceful collapse: 4 → 3 → 2 → 1
============================================================ */
@media (max-width: 1100px) {
#{{ sec_id }} { padding: 48px 0; }
#{{ sec_id }} .ke__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
#{{ sec_id }} { padding: 20px 0; }
#{{ sec_id }}  .page-width{
padding: 0 16px;
}
#{{ sec_id }}  .ke__inner {
gap: 12px;
}
#{{ sec_id }}  .ke__header {
    max-width: 100%;
    margin: 0 auto;
    gap: 8px;
    padding: 0;
}

#{{ sec_id }} .ke__grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
#{{ sec_id }} .ke__title {
font-size: 24px;
font-style: normal;
font-weight: 650;
line-height: normal;
text-transform: capitalize;
}
#{{ sec_id }} .ke__subtitle { 
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-transform: capitalize;
}
#{{ sec_id }}  .ke__card {
    padding: 16px 0;
}
#{{ sec_id }}  .ke__card-desc {
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-transform: capitalize;
}
#{{ sec_id }} .ke__card-tag {

}
}
</style>
{% comment %} <img
class="wave_bottom"
src="https://cdn.shopify.com/s/files/1/0805/9325/6728/files/Vector_4.png?v=1777874800"
alt="wave_bottom"
loading="lazy"
aria-hidden="true"> {% endcomment %}

<section
id="{{ sec_id }}"
class="kidsy-earns"
aria-labelledby="{{ sec_id }}-title">
<div class="page-width">

<div class="ke__inner">

{%- comment -%} Header {%- endcomment -%}
{%- if s.title != blank or s.subtitle != blank -%}
<header class="ke__header">
{%- if s.title != blank -%}
<h2 id="{{ sec_id }}-title" class="ke__title">{{ s.title }}</h2>
{%- endif -%}
{%- if s.subtitle != blank -%}
<p class="ke__subtitle">{{ s.subtitle }}</p>
{%- endif -%}
</header>
{%- endif -%}

{%- comment -%} Card grid — managed via blocks {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="ke__grid" role="list">
{%- for block in section.blocks -%}
{%- if block.type == 'step_card' -%}
{%- assign b = block.settings -%}
<article class="ke__card{% if b.link != blank %} ke__card--link{% endif %}" role="listitem" {{ block.shopify_attributes }}>

{%- if b.link != blank -%}
<a class="ke__card-link" href="{{ b.link }}" aria-label="{{ b.title | escape }}">&nbsp;</a>
{%- endif -%}

{%- comment -%} Icon — custom upload OR built-in preset {%- endcomment -%}
<div class="ke__icon{% if b.icon_size == 'large' %} ke__icon--lg{% endif %}">
{%- if b.icon_image != blank -%}
<img src="{{ b.icon_image | image_url: width: 56 }}" alt="" width="24" height="24" loading="lazy">
{%- else -%}
{%- case b.icon_preset -%}

  {%- when 'user_plus' -%}
    {%- comment -%} Create account / refer a friend {%- endcomment -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="9" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/>
      <path d="M2 21c0-3.87 3.13-7 7-7s7 3.13 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="19" y1="8" x2="19" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="16" y1="11" x2="22" y2="11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'shopping_bag' -%}
    {%- comment -%} Place an order {%- endcomment -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M5 8h14l-1 12a2 2 0 01-2 2H8a2 2 0 01-2-2L5 8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M9 8V6a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'review' -%}
    {%- comment -%} Write a review (chat bubble + star) {%- endcomment -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3 5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-7l-5 4v-4H5a2 2 0 01-2-2V5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M12 6.5l1.3 2.7 2.9.4-2.1 2 .5 2.9-2.6-1.4-2.6 1.4.5-2.9-2.1-2 2.9-.4L12 6.5z" fill="currentColor"/>
    </svg>

  {%- when 'birthday' -%}
    {%- comment -%} Birthday cake {%- endcomment -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4 13h16v7a1 1 0 01-1 1H5a1 1 0 01-1-1v-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M4 13a3 3 0 003-3v-1M9 13a3 3 0 003-3v-1M14 13a3 3 0 003-3v-1M20 13v-1a3 3 0 00-3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="8" y1="3" x2="8" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="12" y1="3" x2="12" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="16" y1="3" x2="16" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    </svg>

  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0022 12z"/>
    </svg>

  {%- when 'share' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="18" cy="6" r="3" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="18" cy="18" r="3" stroke="currentColor" stroke-width="1.8"/>
      <line x1="8.5" y1="10.5" x2="15.5" y2="7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="8.5" y1="13.5" x2="15.5" y2="16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="3" y="9" width="18" height="12" rx="1" stroke="currentColor" stroke-width="1.8"/>
      <rect x="2" y="6" width="20" height="4" rx="1" stroke="currentColor" stroke-width="1.8"/>
      <line x1="12" y1="6" x2="12" y2="21" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 6c-2-3-5-3-5-1s2 1 5 1zM12 6c2-3 5-3 5-1s-2 1-5 1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>

{%- endcase -%}
{%- endif -%}
</div>

<div class="ke__body">
{%- if b.title != blank -%}
<h3 class="ke__card-title">{{ b.title }}</h3>
{%- endif -%}
{%- if b.description != blank -%}
<p class="ke__card-desc">{{ b.description }}</p>
{%- endif -%}
{%- if b.tag_label != blank -%}
<span class="ke__card-tag">{{ b.tag_label }}</span>
{%- endif -%}
</div>

</article>
{%- endif -%}
{%- endfor -%}
</div>
{%- endif -%}

</div>
</div>
</section>

{% schema %}
{
"name": "Every Action Earns",
"tag": "section",
"class": "section-kidsy-earns",
"settings": [
{
"type": "header",
"content": "Section Heading"
},
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Every Action Earns"
},
{
"type": "textarea",
"id": "subtitle",
"label": "Subtitle",
"default": "Points for shopping, sharing, and celebrating with Kidsy. Sign up and start earning immediately — 100 bonus points / $1 the moment your account is created."
},

{
"type": "header",
"content": "Layout"
},
{
"type": "select",
"id": "columns_desktop",
"label": "Desktop columns",
"options": [
{ "value": "2", "label": "2 columns" },
{ "value": "3", "label": "3 columns" },
{ "value": "4", "label": "4 columns" }
],
"default": "4"
},
{
"type": "range",
"id": "padding_top",
"label": "Top padding",
"min": 0, "max": 120, "step": 5, "unit": "px",
"default": 50
},
{
"type": "range",
"id": "padding_bottom",
"label": "Bottom padding",
"min": 0, "max": 120, "step": 5, "unit": "px",
"default": 50
},

{
"type": "header",
"content": "Colors"
},
{
"type": "color",
"id": "color_bg",
"label": "Section background",
"default": "#FFF4E1"
},
{
"type": "color",
"id": "color_card",
"label": "Card background",
"default": "#FFFFFF"
},
{
"type": "color",
"id": "color_text",
"label": "Text",
"default": "#341300"
},
{
"type": "color",
"id": "color_tag",
"label": "Tag background",
"default": "#F45901"
},
{
"type": "color",
"id": "color_tag_text",
"label": "Tag text",
"default": "#FFFFFF"
},
{
"type": "color",
"id": "color_icon_from",
"label": "Icon gradient (top)",
"default": "#F8B086"
}
],
"blocks": [
{
"type": "step_card",
"name": "Step card",
"limit": 12,
"settings": [
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Create Account"
},
{
"type": "text",
"id": "description",
"label": "Description",
"default": "One-time bonus"
},
{
"type": "text",
"id": "tag_label",
"label": "Tag label",
"default": "100 pts / $1"
},
{
"type": "select",
"id": "icon_preset",
"label": "Icon preset",
"options": [
{ "value": "user_plus",    "label": "User plus (Create account / Refer)" },
{ "value": "shopping_bag", "label": "Shopping bag (Place order)" },
{ "value": "review",       "label": "Review (Chat bubble + star)" },
{ "value": "birthday",     "label": "Birthday cake" },
{ "value": "instagram",    "label": "Instagram" },
{ "value": "facebook",     "label": "Facebook" },
{ "value": "share",        "label": "Share" },
{ "value": "gift",         "label": "Gift" }
],
"default": "user_plus"
},
{
"type": "image_picker",
"id": "icon_image",
"label": "Custom icon (optional)",
"info": "Overrides the preset above. PNG or SVG, square format."
},
{
"type": "select",
"id": "icon_size",
"label": "Icon size",
"options": [
{ "value": "default", "label": "Default (24px)" },
{ "value": "large",   "label": "Large (28px)" }
],
"default": "default"
},
{
"type": "url",
"id": "link",
"label": "Card link",
"info": "Optional. Makes the whole card clickable."
}
]
}
],
"presets": [
{
"name": "Every Action Earns",
"blocks": [
{ "type": "step_card", "settings": { "title": "Create Account",      "description": "One-time bonus",     "tag_label": "100 pts / $1",  "icon_preset": "user_plus" } },
{ "type": "step_card", "settings": { "title": "Place an Order",      "description": "Per dollar spent",   "tag_label": "100 pts / $1",  "icon_preset": "shopping_bag" } },
{ "type": "step_card", "settings": { "title": "Write a Review",      "description": "Per approved review","tag_label": "100 pts / $1",  "icon_preset": "review" } },
{ "type": "step_card", "settings": { "title": "Birthday Bonus",      "description": "By tier",            "tag_label": "300 pts / $3",  "icon_preset": "birthday", "icon_size": "large" } },
{ "type": "step_card", "settings": { "title": "Follow on Instagram", "description": "One-time",           "tag_label": "100 pts / $1",  "icon_preset": "instagram" } },
{ "type": "step_card", "settings": { "title": "Follow on Facebook",  "description": "One-time",           "tag_label": "100 pts / $1",  "icon_preset": "facebook" } },
{ "type": "step_card", "settings": { "title": "Share on Social",     "description": "Share on Social",    "tag_label": "100 pts / $1",  "icon_preset": "share" } },
{ "type": "step_card", "settings": { "title": "Refer a Friend",      "description": "When friend orders", "tag_label": "$20 credit",    "icon_preset": "user_plus" } }
]
}
]
}
{% endschema %}
