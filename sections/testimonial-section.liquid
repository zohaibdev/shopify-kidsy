                          </g>
                          <defs>
                          <clipPath id="clip0_343_2739">
                          <rect width="104.692" height="16.4793" fill="white" transform="translate(0.654053)"/>
                          </clipPath>
                          </defs>
                        </svg>
                      </div>
                      <div style="color: {{ section.settings.text_color }}">
                        <p>{{ block.settings.text }}</p>
                      </div>
                      <div class="auth-discription">
                        <img
                          src="{{ block.settings.auth_img | image_url }}"
                          alt="{{ block.settings.heading }}"
                          width="{{ block.settings.auth_img.width }}"
                          height="{{ block.settings.auth_img.height }}"
                          loading="lazy"
                        >
                        <div class="auth-text">
                          <span>{{ block.settings.auth }}</span>
                          <div class="varified-text">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="15"
                              height="15"
                              viewBox="0 0 15 15"
                              fill="none"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M7.07666 14.4065C10.9427 14.4065 14.0767 11.2725 14.0767 7.40649C14.0767 3.5405 10.9427 0.406494 7.07666 0.406494C3.21067 0.406494 0.0766602 3.5405 0.0766602 7.40649C0.0766602 11.2725 3.21067 14.4065 7.07666 14.4065ZM5.37902 11.1789C5.52942 11.3304 5.72579 11.4065 5.92295 11.4065C6.11933 11.4065 6.31648 11.3304 6.46688 11.1789L11.8517 5.73414C12.1517 5.43048 12.1517 4.93849 11.8517 4.63483C11.5509 4.33038 11.0638 4.33038 10.7638 4.63483L5.92295 9.52879L3.38954 6.96764C3.08952 6.66397 2.60247 6.66397 2.30167 6.96764C2.00166 7.2713 2.00166 7.76407 2.30167 8.06774L5.37902 11.1789Z" fill="#202123"/>
                            </svg>
                            <span>Verified purchase</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .testimonial-section .testimonial-main-box { margin: 0 auto; position: relative; max-width: 1372px; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box { border-radius: 25px; overflow: hidden; height: 100%; display: flex; width: 100%; } #shopify-section-{{ section.id }} .testimonial-wrapper .swiper-slide { height: auto; width: auto; padding-bottom: 10px; } #shopify-section-{{ section.id }} .testimonial-wrapper .swiper-slider:not(.swiper-initialized) .swiper-slide { width: calc(28% - 15px); margin-right: 20px; } #shopify-section-{{ section.id }} .testimonial-section h2 { font-size: 48px; color: #000; line-height: 1; margin: 0; text-align: center; font-weight: 500; font-family: "Poppins", sans-serif; position: relative; text-transform: capitalize; } #shopify-section-{{ section.id }} .testimonial-section .btn-link { text-align: center; margin: 0 auto; } #shopify-section-{{ section.id }} .testimonial-section { padding: 7px 0 21px; position: relative; background: #fffbf7; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block img { display: inline-block; width: 100%; height: 100%; object-fit: cover; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .review-box { padding: 30px; border-radius: 25px; width: 376px; background: #fff; display: flex; flex-direction: column; justify-content: center; border: 1px solid #000000; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box p { margin: 16px auto; line-height: 1.3; color: #000; text-align: center; font-size: 16px; font-weight: 400; max-width: 307px; font-family: "Poppins", sans-serif; /* margin: 0 auto; */ letter-spacing: 0; } #shopify-section-{{ section.id }} .testimonial-wrapper .auth-discription { display: flex; gap: 16px; align-items: center; justify-content: center; color: #000; } #shopify-section-{{ section.id }} .testimonial-wrapper .varified-text { display: flex; align-items: center; gap: 5px; } #shopify-section-{{ section.id }} .testimonial-wrapper .star svg { display: block; margin: 0 auto; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box span { line-height: 1; color: #000; font-size: 14px; font-weight: 400; letter-spacing: 0; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .button { height: 42px; max-width: 250px; margin-top: 18px; padding: 0; min-height: inherit; } #shopify-section-{{ section.id }} .testimonial-wrapper .slider-pagination.mobile { display: flex; margin-bottom: 30px; } .add-cart-btn { margin-top: 30px; } #shopify-section-{{ section.id }} .testimonial-wrapper .slider-controls { display: flex; align-items: center; gap: 10px; justify-content: flex-end; margin-top: 32px; max-width: 1100px; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block { width: 202px; position: relative; border: 1px solid #000; border-radius: 25px; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block[data-video] { cursor: pointer; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block .video-overlay { background-color: #0000004D; position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: block; z-index: 1; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block .review-video-trigger { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; z-index: 2; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: block; z-index: 3; object-fit: cover; } .testimonial-section .testimonial-header-block { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; gap: 10px; } .testimonial-section .slider-controls { display: flex; align-items: center; gap: 10px; } .mobile { display: none; } @media(max-width:991px) { .mobile { display: block; } .dekstop { display: none; } #shopify-section-{{ section.id }} .testimonial-wrapper .swiper-slider:not(.swiper-initialized) .swiper-slide { width: calc(80% - 15px); margin-right: 20px; } #shopify-section-{{ section.id }} .testimonial-section .testimonial-main-box { padding: 0; } #shopify-section-{{ section.id }} .testimonial-section .page-width { padding: 0; margin: 0; } #shopify-section-{{ section.id }} .testimonial-section h2 { font-size: 24px; margin: 0; text-align: left; } #shopify-section-{{ section.id }} .testimonial-section { padding: 20px 0 30px; } #shopify-section-{{ section.id }} .testimonial-section .btn-link { margin-right: auto; display: flex; max-width: max-content; font-size: 15px; margin-left: 16px; padding-inline: 20px; } #shopify-section-{{ section.id }} .testimonial-wrapper { align-items: unset; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box p { margin: 16px 0; color: #000; font-size: 12px; font-weight: 400; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box { border-radius: 15px; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block { width: 121px; border-radius:15px; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box span { font-size: 14px; font-weight: 400; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .review-box { padding: 50px 20px; width: 222px; border-radius: 15px; } #shopify-section-{{ section.id }} .testimonial-wrapper .star svg { max-width: 84px; } #shopify-section-{{ section.id }} .testimonial-section svg.bottom-arrow { display: none; } #shopify-section-{{ section.id }} .testimonial-wrapper .card-box .img-block .review-video-trigger svg { width: 29px; height: auto; } .testimonial-section .testimonial-header-block { padding: 0 15px; } }
</style>

<script>
  window.addEventListener("load", (event) => {
     var slider = new Swiper('.testimonial-slider-{{ section.id}}', {
       slidesPerView: 'auto',
       spaceBetween: 18,
       loop: true,
        watchOverflow: true,
        centeredSlides: true,
         navigation: {
           prevEl: '.swiper-{{ section.id }}-prev',
           nextEl: '.swiper-{{ section.id }}-next',
         },
          breakpoints: {
            991: {
              spaceBetween: 29,
              centeredSlides: false,
              watchOverflow: false,
            }
        }
       
     });

     const triggers = document.querySelectorAll('[data-video]');

     triggers.forEach(trigger => {
       trigger.addEventListener('click', function (e) {
         e.preventDefault();
         const imgBlock = this.closest('.img-block');
         const videoUrl = imgBlock.getAttribute('data-video');
         const existingVideo = imgBlock.querySelector('video');

         // If there's already a video in this block
         if (existingVideo) {
           // Toggle play/pause
           if (existingVideo.paused) {
             existingVideo.play();
           } else {
             existingVideo.pause();
           }
           return;
         }

         // Otherwise, remove any other playing videos
         document.querySelectorAll('.img-block').forEach(block => {
           block.classList.remove('video-played');
           const vid = block.querySelector('video');
           if (vid) {
             vid.pause();
             vid.remove();
           }
         });

         // Then add and play the new video
         imgBlock.classList.add('video-played');
         const video = document.createElement('video');
         video.src = videoUrl;
         video.controls = true;
         video.muted = false;
         video.autoplay = true;
         video.loop = true;
         video.playsInline = true;

         imgBlock.appendChild(video);
       });
     });



  });
</script>

{% schema %}
{
  "name": "Testimonial Slider",
  "settings": [

    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default": "EXPLORE OUR SOLUTIONS"
    },
    {
        "type": "url",
        "id": "btn_link",
        "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "review_block",
      "name": "Review Slide",
      "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Select Video"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "auth_img",
          "label": "Auth Image"
        },
        {
          "type": "text",
          "id": "auth",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Slider",
      "blocks": [
        {
          "type": "review_block"
        },
        {
          "type": "review_block"
        },
        {
          "type": "review_block"
        }
      ]
    }
  ],
}
{% endschema %}
