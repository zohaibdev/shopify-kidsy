          </svg>
        </div>
        <div
          class="swiper-button-next swiper-{{ section.id }}-next"
          style="transform: none; left: 0px; right: 0; position: relative; top: 0; margin: 0;"
        >
          <!-- SVG Arrow -->
          <svg xmlns="http://www.w3.org/2000/svg" width="57" height="57" viewBox="0 0 57 57" fill="none">
            <circle cx="28.5" cy="28.5" r="28" fill="white" stroke="black"/>
            <path d="M25.1115 19.3259C25.0401 19.2594 24.9828 19.1792 24.9431 19.0901C24.9034 19.001 24.8821 18.9047 24.8803 18.8072C24.8786 18.7096 24.8966 18.6127 24.9331 18.5223C24.9696 18.4318 25.024 18.3496 25.093 18.2806C25.162 18.2116 25.2442 18.1572 25.3347 18.1207C25.4251 18.0841 25.522 18.0662 25.6196 18.0679C25.7172 18.0696 25.8134 18.091 25.9025 18.1307C25.9916 18.1704 26.0718 18.2277 26.1383 18.2991L35.8258 27.9866C35.9619 28.1228 36.0383 28.3075 36.0383 28.5C36.0383 28.6925 35.9619 28.8772 35.8258 29.0134L26.1383 38.7009C26.0006 38.8293 25.8184 38.8991 25.6302 38.8958C25.442 38.8925 25.2624 38.8162 25.1293 38.6831C24.9962 38.55 24.9199 38.3704 24.9166 38.1822C24.9133 37.994 24.9831 37.8118 25.1115 37.6741L34.2843 28.5L25.1115 19.3259Z" fill="black"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="testimonial-wrapper">
      <div class="swiper-container">
        <div class="swiper swiper-slider testimonial-slider-{{ section.id}}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" data-block-id="{{ block.id }}">
                <div class="card-box">
                  {%- if block.settings.image != blank -%}
                    {% liquid
                      assign videoObj = block.settings.video.sources | where: 'format', 'mp4'
                      assign videoURL = videoObj[0].url
                    %}
                    <div
                      class="img-block"
                      {% if block.settings.video != blank %}
                        data-video="{{ videoURL }}"
                      {% endif %}
                    >
                      <img
                        srcset="
                          {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
                          {%- if block.settings.image.width >= 520 -%}{{ block.settings.image | image_url: width: 520 }} 520w,{%- endif -%}
                          {%- if block.settings.image.width >= 650 -%}{{ block.settings.image | image_url: width: 650 }} 650w,{%- endif -%}
                          {%- if block.settings.image.width >= 780 -%}{{ block.settings.image | image_url: width: 780 }} 780w,{%- endif -%}
                          {%- if block.settings.image.width >= 900 -%}{{ block.settings.image | image_url: width: 900 }} 900w,{%- endif -%}
                          {%- if block.settings.image.width >= 1000 -%}{{ block.settings.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                        "
                        src="{{ block.settings.image | image_url: width: 50 }}"
                        sizes="(min-width: 1440px) 25vw, (min-width: 750px) calc((100vw - 130px) / 2), 100vw"
                        alt="{{ block.settings.image.alt | default: shop.name | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width | divided_by: 3 }}"
                        height="{{ block.settings.image.height | divided_by: 3 }}"
                      >
                      {% if block.settings.video != blank %}
                        <div class="video-overlay" style="background-color: #0000004D;"></div>
                        <a href="#" class="review-video-trigger">
                          <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                            <path opacity="0.4" d="M22.4309 0C18.1651 0 13.995 1.26498 10.4481 3.63497C6.90111 6.00496 4.13661 9.37352 2.50413 13.3147C0.87165 17.2558 0.444519 21.5925 1.27675 25.7765C2.10898 29.9604 4.16319 33.8035 7.17962 36.8199C10.196 39.8364 14.0392 41.8906 18.2231 42.7228C22.407 43.555 26.7437 43.1279 30.6849 41.4954C34.626 39.863 37.9946 37.0984 40.3646 33.5515C42.7346 30.0046 43.9996 25.8345 43.9996 21.5686C43.9996 15.8483 41.7272 10.3622 37.6823 6.3173C33.6374 2.2724 28.1513 0 22.4309 0ZM17.9375 30.5555V12.5817L32.3166 21.5686L17.9375 30.5555Z" fill="white"/>
                          </svg>
                        </a>
                      {%- endif -%}
                    </div>
                  {% else %}
                    <div class="review-box">
                      <div class="star">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="106"
                          height="17"
                          viewBox="0 0 106 17"
                          fill="none"
                        >
                          <g clip-path="url(#clip0_343_2739)">
                          <path d="M8.5678 0.53423C8.8677 -0.178077 9.8891 -0.178076 10.189 0.534232L11.959 4.7384C12.0855 5.03869 12.3713 5.24387 12.6995 5.26986L17.2937 5.63373C18.0721 5.69538 18.3877 6.65505 17.7947 7.15693L14.2944 10.1191C14.0444 10.3307 13.9351 10.6627 14.0115 10.979L15.0809 15.4081C15.2621 16.1585 14.4358 16.7516 13.7694 16.3495L9.83602 13.976C9.55507 13.8065 9.20173 13.8065 8.92079 13.976L4.98743 16.3495C4.32099 16.7516 3.49466 16.1585 3.67585 15.4081L4.74527 10.979C4.82165 10.6627 4.71246 10.3307 4.46245 10.1191L0.962076 7.15693C0.369013 6.65505 0.684647 5.69538 1.46305 5.63373L6.05735 5.26986C6.38551 5.24387 6.67137 5.03869 6.7978 4.7384L8.5678 0.53423Z" fill="black"/>
