{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } @media (max-width: 768px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; } }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="kidsy-social-wrapper page-width section-{{ section.id }}-padding">

    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper">
        <div class="section-header-content">
          {% if section.settings.heading_link != blank %}
            <a href="{{ section.settings.heading_link }}" class="section--title h3" title="{{ section.settings.title | escape }}">
              {{ section.settings.title | escape }}
            </a>
          {% else %}
            <h3 class="section--title h3">
              {{ section.settings.title | escape }}
            </h3>
          {% endif %}
        </div>
        <div class="section-header-social">
          {%- if section.settings.show_social -%}
            {%- render 'social-icons', class: 'kidsy__list-social' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}

    <div class="app-wrapper">
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Kidsy social",
    "class": "kidsy-social--section",
    "max_blocks": 1,
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color Scheme",
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Join Our Community of Savvy Parents"
      },
      {
        "type": "url",
        "id": "heading_link",
        "label": "Heading link URL"
      },
      {
        "type": "checkbox",
        "id": "show_social",
        "default": true,
        "label": "t:sections.footer.settings.show_social.label",
        "info": "t:sections.footer.settings.show_social.info"
      },
      {
        "type": "header",
        "content": "Section Padding - Desktop"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "header",
        "content": "Section Padding - Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding Top (px)",
        "min": 0,
        "max": 80,
        "step": 5,
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding Bottom (px)",
        "min": 0,
        "max": 80,
        "step": 5,
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "Kidsy Social"
      }
    ]
  }
{% endschema %}