  <div class="page-width">
    <div class="rc-{{ uid }}__container">
    <div class="rc-{{ uid }}__inner">
      <div class="rc-{{ uid }}__stack">

        {%- comment -%} ============= STATS BANNER ============= {%- endcomment -%}
        {%- if show_banner and stat_blocks.size > 0 -%}
          <div class="rc-{{ uid }}__banner">

            {%- for block in stat_blocks -%}
              <div class="rc-{{ uid }}__stat" {{ block.shopify_attributes }}>
                <div class="rc-{{ uid }}__stat-num">{{ block.settings.number }}</div>
                <div class="rc-{{ uid }}__stat-label">{{ block.settings.label }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

          {%- comment -%} ============= REVIEW SLIDER ============= {%- endcomment -%}

        {%- if review_blocks.size > 0 -%}
          <div class="rc-{{ uid }}__viewport" data-rc-viewport tabindex="0" aria-label="Customer reviews carousel">
            <div class="rc-{{ uid }}__track" data-rc-track></div>
          </div>
        {%- endif -%}

              {%- if review_blocks.size > 0 -%}
        <div class="rc-{{ uid }}__controls">
          <div class="rc-{{ uid }}__dots" data-rc-dots role="tablist" aria-label="Review pagination"></div>
          <div class="rc-{{ uid }}__arrows">
            <button type="button" class="rc-{{ uid }}__arrow rc-{{ uid }}__arrow--prev" data-rc-prev aria-label="Previous reviews">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M15.0001 4.5L7.50012 12L15.0001 19.5" stroke="#341300" stroke-width="1.41871" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="rc-{{ uid }}__arrow rc-{{ uid }}__arrow--next" data-rc-next aria-label="Next reviews">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M9 4.5L16.5 12L9 19.5" stroke="white" stroke-width="1.41871" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}


      </div>


    </div>
    </div>
  </div>




  {%- comment -%} ============= JSON DATA FOR SLIDER ============= {%- endcomment -%}
  <script type="application/json" data-rc-data>
    {
      "reviews": [
        {%- for block in review_blocks -%}
          {
            "title":    {{ block.settings.title    | default: ''  | json }},
            "body":     {{ block.settings.body     | default: ''  | json }},
            "name":     {{ block.settings.name     | default: ''  | json }},
            "initials": {{ block.settings.initials | default: ''  | json }},
            "avatar":   {%- if block.settings.avatar -%}{{ block.settings.avatar | image_url: width: 100 | json }}{%- else -%}null{%- endif -%},
            "rating":   {{ block.settings.rating   | default: 5   | json }},
            "verified": {{ block.settings.verified | default: true | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
  <div class="wave_bottom">
<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="91" viewBox="0 0 1440 91" fill="none">
<path d="M1092.5 65.5287C1256.8 63.8105 1392.1 40.4585 1440 8.95776L1440 91L0 90.9999L2.22676e-06 65.5287C402 -18.4469 420.811 -12.5285 644.857 31.9361C845.065 71.67 1018.65 70.5402 1092.5 65.5287Z" fill="#FFF4E1"/>
</svg>
</div>
</section>

<script>
(function(){
  'use strict';
  const SECTION_ID = {{ section.id | json }};
  const root = document.getElementById('ReviewsCarousel-' + SECTION_ID);
  if (!root) return;

  const dataEl = root.querySelector('[data-rc-data]');
  if (!dataEl) return;

  let DATA;
  try { DATA = JSON.parse(dataEl.textContent); }
  catch (e) { console.warn('[reviews-carousel] Bad JSON', e); return; }

  const REVIEWS = DATA.reviews || [];
  if (!REVIEWS.length) return;

  const viewport = root.querySelector('[data-rc-viewport]');
  const track    = root.querySelector('[data-rc-track]');
  const dotsWrap = root.querySelector('[data-rc-dots]');
  const prevBtn  = root.querySelector('[data-rc-prev]');
  const nextBtn  = root.querySelector('[data-rc-next]');
  if (!viewport || !track) return;

  /* ---------- Build a single card ---------- */
  function buildCard(r) {
    const card  = document.createElement('article');
    card.className = 'rc-{{ uid }}__card';

    const inner = document.createElement('div');
    inner.className = 'rc-{{ uid }}__card-inner';

    // Stars
    const stars = document.createElement('div');
    stars.className = 'rc-{{ uid }}__stars';
    const rating = Math.max(0, Math.min(5, Number(r.rating) || 5));
    for (let i = 0; i < rating; i++) {
      stars.insertAdjacentHTML('beforeend',
        '<svg class="rc-{{ uid }}__star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 16" fill="none" aria-hidden="true">' +
          '<path d="M7.20978 0.594188C7.46715 -0.197915 8.58777 -0.197915 8.84514 0.594187L10.1508 4.61248C10.2659 4.96672 10.596 5.20656 10.9684 5.20656H15.1935C16.0264 5.20656 16.3727 6.27233 15.6989 6.76187L12.2807 9.24531C11.9794 9.46425 11.8533 9.85231 11.9684 10.2066L13.274 14.2248C13.5314 15.0169 12.6248 15.6756 11.951 15.1861L8.53281 12.7026C8.23148 12.4837 7.82344 12.4837 7.52211 12.7026L4.10394 15.1861C3.43014 15.6756 2.52354 15.017 2.78091 14.2248L4.08654 10.2066C4.20164 9.85231 4.07555 9.46425 3.77421 9.24531L0.356048 6.76187C-0.317755 6.27233 0.0285332 5.20656 0.861399 5.20656H5.08648C5.45895 5.20656 5.78906 4.96672 5.90416 4.61248L7.20978 0.594188Z" fill="#FFBC38"/>' +
        '</svg>');
    }

    // Text
    const text  = document.createElement('div');
    text.className = 'rc-{{ uid }}__text';
    const title = document.createElement('p');
    title.className = 'rc-{{ uid }}__title';
    title.textContent = r.title || '';
    const body  = document.createElement('p');
    body.className = 'rc-{{ uid }}__body';
    body.textContent = r.body || '';
    text.append(title, body);

    // Divider
    const hr = document.createElement('hr');
    hr.className = 'rc-{{ uid }}__divider';

    // Author
    const author = document.createElement('div');
    author.className = 'rc-{{ uid }}__author';

    const avatar = document.createElement('div');
    avatar.className = 'rc-{{ uid }}__avatar';
    if (r.avatar) {
      const img = document.createElement('img');
      img.src = r.avatar;
      img.alt = r.name || '';
      img.loading = 'lazy';
      avatar.appendChild(img);
    } else {
      const initials = document.createElement('span');
      initials.textContent = r.initials || '';
      avatar.appendChild(initials);
    }

    const info = document.createElement('div');
    info.className = 'rc-{{ uid }}__author-info';
    const name = document.createElement('div');
    name.className = 'rc-{{ uid }}__author-name';
    name.textContent = r.name || '';
    info.appendChild(name);

    if (r.verified) {
      const v = document.createElement('div');
      v.className = 'rc-{{ uid }}__verified';
      v.innerHTML =
        '<span class="rc-{{ uid }}__verified-text">Verified Buyer</span>' +
        '<svg class="rc-{{ uid }}__verified-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" aria-hidden="true">' +
          '<path d="M8 16C6.89583 16 5.85938 15.7917 4.89062 15.375C3.91146 14.9583 3.0599 14.388 2.33594 13.6641C1.61198 12.9401 1.04167 12.0885 0.625 11.1094C0.208333 10.1406 0 9.10417 0 8C0 6.89583 0.208333 5.85938 0.625 4.89062C1.04167 3.91146 1.61198 3.0599 2.33594 2.33594C3.0599 1.61198 3.91146 1.04167 4.89062 0.625C5.85938 0.208333 6.89583 0 8 0C9.10417 0 10.1406 0.208333 11.1094 0.625C12.0885 1.04167 12.9401 1.61198 13.6641 2.33594C14.388 3.0599 14.9583 3.91146 15.375 4.89062C15.7917 5.85938 16 6.89583 16 8C16 9.10417 15.7917 10.1406 15.375 11.1094C14.9583 12.0885 14.388 12.9401 13.6641 13.6641C12.9401 14.388 12.0885 14.9583 11.1094 15.375C10.1406 15.7917 9.10417 16 8 16ZM11.4531 4.42188L6.71875 9.14062L4.46875 6.90625L3 8.375L6.71875 12.0781L12.9219 5.89062L11.4531 4.42188Z" fill="#F45901"/>' +
        '</svg>';
      info.appendChild(v);
    }

    author.append(avatar, info);
    inner.append(stars, text, hr, author);
    card.appendChild(inner);
    return card;
  }

  /* ---------- Infinite slider engine ---------- */
  const CARD_GAP = 20;
  const N        = REVIEWS.length;
  const BUFFER   = N;

  let cardWidth = 341;
  let cardStep  = cardWidth + CARD_GAP;

  let index    = BUFFER;
  let currentX = 0;

  let isDragging = false, startX = 0, startTransX = 0;
  let lastX = 0, lastTime = 0, velocity = 0;
  let pointerId = null, dragMoved = false;

  function renderTrack() {
    track.innerHTML = '';
    // Leading clones (last N)
    for (let i = 0; i < BUFFER; i++) {
      track.appendChild(buildCard(REVIEWS[(N - BUFFER + i + N) % N]));
    }
    // Real cards
    for (let i = 0; i < N; i++) track.appendChild(buildCard(REVIEWS[i]));
    // Trailing clones (first N)
    for (let i = 0; i < BUFFER; i++) {
      track.appendChild(buildCard(REVIEWS[i % N]));
    }
  }

  function recompute() {
    const firstCard = track.querySelector('.rc-{{ uid }}__card');
    if (firstCard) {
      cardWidth = firstCard.getBoundingClientRect().width;
      cardStep  = cardWidth + CARD_GAP;
    }
    buildDots();
    setIndex(index, false);
  }

  function buildDots() {
    if (!dotsWrap) return;
    dotsWrap.innerHTML = '';
    for (let i = 0; i < N; i++) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'rc-{{ uid }}__dot';
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-label', 'Go to review ' + (i + 1));
      b.addEventListener('click', () => {
        const r = realIndex();
        let delta = i - r;
        if (delta >  N / 2) delta -= N;
        if (delta < -N / 2) delta += N;
        setIndex(index + delta, true);
      });
      dotsWrap.appendChild(b);
    }
    updateDots();
  }

  function realIndex() { return ((index - BUFFER) % N + N) % N; }

  function updateDots() {
    if (!dotsWrap) return;
    const r = realIndex();
    [...dotsWrap.children].forEach((d, i) => {
      d.classList.toggle('active', i === r);
      d.setAttribute('aria-selected', i === r ? 'true' : 'false');
    });
  }

  function xForIndex(i) { return -i * cardStep; }

  function applyTransform(x, animate) {
    track.classList.toggle('no-transition', !animate);
    track.style.transform = 'translateX(' + x + 'px)';
    if (!animate) track.offsetHeight;
  }

  function setIndex(newIndex, animate) {
    index    = newIndex;
    currentX = xForIndex(index);
    applyTransform(currentX, animate);
    updateDots();

    const finalize = () => {
      let normalized = index;
      while (normalized <  BUFFER)     normalized += N;
      while (normalized >= BUFFER + N) normalized -= N;
      if (normalized !== index) {
        index    = normalized;
        currentX = xForIndex(index);
        applyTransform(currentX, false);
      }
    };

    if (animate) {
      track.addEventListener('transitionend', function onEnd(e) {
        if (e.propertyName !== 'transform') return;
        track.removeEventListener('transitionend', onEnd);
        finalize();
      });
    } else {
      finalize();
    }
  }

  if (prevBtn) prevBtn.addEventListener('click', () => setIndex(index - 1, true));
  if (nextBtn) nextBtn.addEventListener('click', () => setIndex(index + 1, true));

  /* Pointer drag */
  function onPointerDown(e) {
    if (e.button !== undefined && e.button !== 0) return;
    isDragging  = true;
    dragMoved   = false;
    pointerId   = e.pointerId;
    startX      = e.clientX;
    lastX       = e.clientX;
    lastTime    = performance.now();
    velocity    = 0;
    startTransX = currentX;
    viewport.classList.add('is-dragging');
    if (viewport.setPointerCapture) viewport.setPointerCapture(pointerId);
    viewport.addEventListener('pointermove',   onPointerMove);
    viewport.addEventListener('pointerup',     onPointerUp);
    viewport.addEventListener('pointercancel', onPointerUp);
  }
  function onPointerMove(e) {
    if (!isDragging) return;
    const dx = e.clientX - startX;
    if (Math.abs(dx) > 4) dragMoved = true;
    currentX = startTransX + dx;
    applyTransform(currentX, false);
    const now = performance.now();
    const dt  = now - lastTime || 1;
    velocity  = (e.clientX - lastX) / dt;
    lastX     = e.clientX;
    lastTime  = now;
  }
  function onPointerUp() {
    if (!isDragging) return;
    isDragging = false;
    viewport.classList.remove('is-dragging');
    if (pointerId !== null && viewport.releasePointerCapture) viewport.releasePointerCapture(pointerId);
    viewport.removeEventListener('pointermove',   onPointerMove);
    viewport.removeEventListener('pointerup',     onPointerUp);
    viewport.removeEventListener('pointercancel', onPointerUp);
    const movedCards = -currentX / cardStep;
    const flick      = velocity * 200;
    const projected  = movedCards - flick / cardStep;
    setIndex(Math.round(projected), true);
  }
  viewport.addEventListener('pointerdown', onPointerDown);

  /* Suppress click after drag */
  viewport.addEventListener('click', (e) => {
    if (dragMoved) {
      e.preventDefault();
      e.stopPropagation();
      dragMoved = false;
    }
  }, true);

  /* Keyboard */
  viewport.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  { e.preventDefault(); setIndex(index - 1, true); }
    if (e.key === 'ArrowRight') { e.preventDefault(); setIndex(index + 1, true); }
  });

  /* Init + responsive */
  renderTrack();
  recompute();

  let resizeRaf;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(recompute);
  });
})();
</script>

{% schema %}
{
  "name": "Reviews & Stats Carousel",
  "tag": "section",
  "class": "section-reviews-carousel",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_banner", "label": "Show stats banner", "default": true },
    { "type": "checkbox", "id": "show_squiggles", "label": "Show decorative squiggles", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color",     "label": "Section background", "default": "#ffbc38" },
    { "type": "color", "id": "card_bg",      "label": "Review card background", "default": "#fff4e1" },
    { "type": "color", "id": "accent_color", "label": "Accent (stars, active dot, next arrow)", "default": "#f45901" },
    { "type": "color", "id": "text_color",   "label": "Text color", "default": "#341300" },
    { "type": "color", "id": "avatar_bg",    "label": "Avatar background", "default": "#fddecc" },
    { "type": "color", "id": "border_color", "label": "Borders & inactive dot", "default": "#341300", "info": "Used at 19% opacity in the design." },
    { "type": "text",  "id": "banner_tint",  "label": "Stats banner tint (CSS color)", "default": "rgba(255,255,255,0.46)", "info": "Use rgba() for translucency." },

    { "type": "header", "content": "Typography" },
    { "type": "text", "id": "font_family", "label": "Font family stack", "default": "'Roobert TRIAL', 'Manrope', system-ui, sans-serif", "info": "Use the font name + fallbacks. Load the actual font in theme.liquid." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "100K+" },
        { "type": "text", "id": "label",  "label": "Label",  "default": "Kidsy Points Members" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 30,
      "settings": [
        { "type": "text", "id": "title", "label": "Headline", "default": "Great experience" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Shipping was fast and the items were of great quality." },
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "Jane Doe" },
        { "type": "text", "id": "initials", "label": "Initials (fallback if no avatar)", "default": "JD", "info": "Shown when no avatar image is set." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image (optional)" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified Buyer\" badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews & Stats Carousel",
      "blocks": [
        { "type": "stat", "settings": { "number": "100K+", "label": "Kidsy Points Members" } },
        { "type": "stat", "settings": { "number": "10%",   "label": "Back on Every Order" } },
        { "type": "stat", "settings": { "number": "$[X]",  "label": "Avg. Member Savings / Year" } },
        {
          "type": "review",
          "settings": {
            "title": "What a great idea to resell baby items…",
            "body":  "“What a great idea to resell baby items that are normally so crazy expensive! Plus free shipping over $50 and the merchandise is brand new! OMG you guys are the BEST!!!!”",
            "name":  "Judy Mcdermott",
            "initials": "JM",
            "rating": 5,
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Love shopping on kidsy",
            "body":  "The price is what made me buy it from here. I bought a stroller for my grandson and I didn't want to spend a lot of money. Because we just needed when he comes over.",
            "name":  "Maria Z.",
            "initials": "MZ",
            "rating": 5,
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Perfect condition, and fast delivery.",
            "body":  "It came out great and the shipping was very fast. And the product was in perfect condition.",
