{%- comment -%}
============================================================
Section: Reviews & Stats Carousel (Kidsy)
File:    sections/reviews-stats-carousel.liquid

Pixel-perfect implementation of:
- Desktop (1440):  node 10083-1356
- Mobile:          node 10083-2042

A full-width band with:
• A semi-transparent stats banner (1–N stat blocks)
• An infinite, draggable review carousel (1–N review blocks)
• Dot pagination + prev/next arrows
• Decorative squiggles (white left, orange right)

All copy, colors, sizes and items are merchant-editable via
section settings + blocks.
============================================================
{%- endcomment -%}
<link rel="preload" href="{{ 'custom.css' | asset_url }}" as="style">
{%- liquid
  assign s            = section.settings
  assign uid          = section.id
  assign bg_color     = s.bg_color | default: '#ffbc38'
  assign card_bg      = s.card_bg | default: '#fff4e1'
  assign accent       = s.accent_color | default: '#f45901'
  assign text_color   = s.text_color | default: '#341300'
  assign banner_tint  = s.banner_tint | default: 'rgba(255,255,255,0.46)'
  assign avatar_bg    = s.avatar_bg | default: '#fddecc'
  assign border_color = s.border_color | default: 'rgba(52,19,0,0.19)'
  assign max_width    = s.max_width | default: 1440
  assign show_banner  = s.show_banner

  assign stat_blocks   = section.blocks | where: 'type', 'stat'
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<style>
  #ReviewsCarousel-{{ uid }} {
    --rc-bg:        {{ bg_color }};
    --rc-card-bg:   {{ card_bg }};
    --rc-accent:    {{ accent }};
    --rc-text:      {{ text_color }};
    --rc-banner:    {{ banner_tint }};
    --rc-avatar-bg: {{ avatar_bg }};
    --rc-border:    {{ border_color }};
    --rc-max:       {{ max_width }}px;

    background: var(--rc-bg);
    width: 100%;
    overflow: hidden;
    position: relative;
    color: var(--rc-text);
font-family: "Roobert TRIAL", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Outer container — pixel-perfect to Figma 1440: 50px L/R, 60px T/B */
  .rc-{{ uid }}__container {
    width: 100%;
    margin: 0 auto;
    padding: {{ s.padding_top | default: 60 }}px 0 {{ s.padding_bottom | default: 60 }}px;
    position: relative;
  }
  {% comment %} .reviews_slider {
    padding-left: 50px;
    width: 100%;
} {% endcomment %}

  .rc-{{ uid }}__inner { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .rc-{{ uid }}__stack { display: flex; flex-direction: column; gap: 20px; align-items: center; width: 100%; }

  /* ============= STATS BANNER ============= */
  .rc-{{ uid }}__banner {
    position: relative;
    width: 100%;
    height: 232px;
    background: var(--rc-banner);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 12px;
    overflow: visible;
  }
  .rc-{{ uid }}__stat {
    padding: 20px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 5px;
    text-transform: capitalize;
    text-align: center;
  }
  .rc-{{ uid }}__stat-num {
    font-weight: 650;
    font-size: 56px;
    line-height: 1.1;
    text-align: center;
    color: var(--rc-text);
  }
  .rc-{{ uid }}__stat-label {
    font-weight: 650;
    font-size: 24px;
    line-height: normal;
    text-align: center;
    white-space: nowrap;
    color: var(--rc-text);
  }

  /* Decorative squiggles */
  .rc-{{ uid }}__squiggle {
    position: absolute;
    pointer-events: none;
  }
  /* Desktop white squiggle — left of banner */
  .rc-{{ uid }}__squiggle--left {
    left: -0;
    top: 168px;
    width: auto;
    height: auto;
  }
  /* Desktop orange squiggle — top right of banner */
  .rc-{{ uid }}__squiggle--right {
    width: auto;
    height: auto;
    right: 0px;
    top: 70px;
        z-index: 1;
  }

  /* ============= SLIDER ============= */
  .rc-{{ uid }}__viewport {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  .rc-{{ uid }}__viewport.is-dragging { cursor: grabbing; }

  .rc-{{ uid }}__track {
    display: flex;
    gap: 20px;
    align-items: stretch;
    will-change: transform;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rc-{{ uid }}__track.no-transition { transition: none !important; }
  .rc-{{ uid }}__viewport.is-dragging .rc-{{ uid }}__track { transition: none; }

  /* Card — 341×308 desktop */
  .rc-{{ uid }}__card {
    background: var(--rc-card-bg);
    border: 1px solid var(--rc-border);
    border-radius: 6px;
    width: 341px;
    height: 308px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    -webkit-user-drag: none;
  }
  .rc-{{ uid }}__card * { -webkit-user-drag: none; }

  .rc-{{ uid }}__card-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    justify-content: center;
    width: 297px;
  }

  /* Stars row */
  .rc-{{ uid }}__stars {
    display: flex;
    align-items: center;
    height: 18px;
    width: 100%;
  }
  .rc-{{ uid }}__star {
    width: 20.634px;
    height: 20.634px;
    flex-shrink: 0;
    display: block;
  }

  /* Text block — 297×140 desktop */
  .rc-{{ uid }}__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 297px;
    height: 140px;
    text-transform: capitalize;
    color: var(--rc-text);
    overflow: hidden;
  }
  .rc-{{ uid }}__title {
    font-size: 16px;
    font-weight: 650;
    line-height: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }
  .rc-{{ uid }}__body {
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    margin: 0;
    overflow: hidden;
  }

  /* Divider */
  .rc-{{ uid }}__divider {
    width: 100%;
    height: 1px;
    border: none;
    border-top: 1px solid var(--rc-border);
    margin: 0;
  }

  /* Author row */
  .rc-{{ uid }}__author {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .rc-{{ uid }}__avatar {
    width: 50px; height: 50px;
    background: var(--rc-avatar-bg);
    border: 1px solid var(--rc-border);
    border-radius: 100px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .rc-{{ uid }}__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .rc-{{ uid }}__avatar span {
    font-weight: 650;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.36px;
    line-height: normal;
    color: var(--rc-text);
  }
  .rc-{{ uid }}__author-info {
    display: flex; flex-direction: column;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }
  .rc-{{ uid }}__author-name {
    font-weight: 650;
    font-size: 16px;
    text-transform: capitalize;
    line-height: normal;
    color: var(--rc-text);
  }
  .rc-{{ uid }}__verified {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rc-{{ uid }}__verified-text {
    font-weight: 400;
    font-size: 16px;
    color: var(--rc-accent);
    text-transform: capitalize;
    line-height: normal;
  }
  .rc-{{ uid }}__verified-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    display: block;
  }

  /* ============= CONTROLS ============= */
  .rc-{{ uid }}__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 10px;
  }
  .rc-{{ uid }}__dots {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .rc-{{ uid }}__dot {
    width: 17.375px;
    height: 17.375px;
    border-radius: 50%;
    background: rgba(254, 254, 254, 0.38);
    border: 0.869px solid var(--rc-border);
    flex-shrink: 0;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .rc-{{ uid }}__dot:hover  { transform: scale(1.1); }
  .rc-{{ uid }}__dot.active { background: var(--rc-accent); border-color: var(--rc-accent); }

  .rc-{{ uid }}__arrows {
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .rc-{{ uid }}__arrow {
    width: 50px; height: 50px;
    border-radius: 100px;
    border: 1px solid var(--rc-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s ease;
    background: #fff;
    padding: 0;
  }
  .rc-{{ uid }}__arrow:hover { transform: scale(1.05); }
  .rc-{{ uid }}__arrow--next {
    background: var(--rc-accent);
    border-color: transparent;
  }

  /* Mobile-only / desktop-only show flags */
  .rc-{{ uid }}__mb { display: none; }
  .rc-{{ uid }}__dt { display: block; }

  /* ============= MOBILE ============= */
  @media (max-width: 768px) {
    .rc-{{ uid }}__container {
      padding: 20px 0;
    }
  {% comment %} .rc-{{ uid }}__controls {
    padding-right: 16px;
  } {% endcomment %}
#ReviewsCarousel-{{ uid }} .page-width{
padding:0 16px;
}
{% comment %} .reviews_slider {
    padding-left: 16px;
        position: relative;
} {% endcomment %}
    .rc-{{ uid }}__inner { gap: 10px; }
    .rc-{{ uid }}__stack { gap: 20px; }

    /* Banner — vertical stack */
    .rc-{{ uid }}__banner {
      height: auto;
      flex-direction: column;
      gap: 24px;
      padding: 24px 12px;
    }
    .rc-{{ uid }}__stat {
      padding: 0;
      width: 280px;
      max-width: 100%;
    }
    .rc-{{ uid }}__stat-num {
      font-size: 30px;
      line-height: 1.1;
    }
    .rc-{{ uid }}__stat-label {
      font-size: 18px;
      white-space: normal;
    }
    {% comment %} .rc-{{ uid }}__track{
    } {% endcomment %}

    /* Hide desktop squiggles, show mobile ones */
    .rc-{{ uid }}__dt { display: none; }
    .rc-{{ uid }}__mb { display: block; }

    .rc-{{ uid }}__squiggle--mb-right {
      position: absolute;
      right: 0;
      top: 13px;
      z-index: 2;
      pointer-events: none;
    }
    .rc-{{ uid }}__squiggle--mb-left {
      position: absolute;
      left: 0;
      top: 163px;
      pointer-events: none;
    }

    /* Card — 260 wide, 15 padding */
    .rc-{{ uid }}__card {
      width: 260px;
      height: auto;
      min-height: 0;
      padding: 15px;
    }
    .rc-{{ uid }}__card-inner {
      width: 230px;
      gap: 10px;
      align-items: flex-start;
    }
    .rc-{{ uid }}__star {
      width: 16px;
      height: 16px;
    }
    .rc-{{ uid }}__text {
      width: 230px;
      height: auto;
      gap: 10px;
      font-size: 14px;
    }
    .rc-{{ uid }}__title {
      font-size: 14px;
      white-space: normal;
    }
    .rc-{{ uid }}__body {
      font-size: 14px;
    }

    .rc-{{ uid }}__avatar {
      width: 40px; height: 40px;
    }
    .rc-{{ uid }}__avatar span {
      font-size: 14px;
      letter-spacing: 0.28px;
    }
    .rc-{{ uid }}__author-name { font-size: 14px; }
    .rc-{{ uid }}__verified-text { font-size: 14px; }
    .rc-{{ uid }}__verified-icon { width: 14px; height: 14px; }

    /* Mobile dots & arrows */
    .rc-{{ uid }}__dots { gap: 5px; }
    .rc-{{ uid }}__dot {
      width: 12px;
      height: 12px;
    }
    .rc-{{ uid }}__arrows { gap: 5px; }
    .rc-{{ uid }}__arrow {
      width: 30px; height: 30px;
    }
    .rc-{{ uid }}__arrow svg {
      width: 15px;
      height: 15px;
    }
  }
</style>

<section
  id="ReviewsCarousel-{{ uid }}"
  class="reviews-carousel"
  data-section-id="{{ section.id }}"
  data-section-type="reviews-stats-carousel">

     {%- if s.show_squiggles -%}
