{% comment %}
============================================================
Section: Three Steps to Savings
------------------------------------------------------------
Three-card "how it works" section matching Figma design:
• Centered header with title + subtitle
• Three large step cards (430px wide, 373px tall on desktop)
• Each card: numbered badge floating above (circle with number),
orange icon block, uppercase title, body copy, and CTA button
• Two decorative cream blobs in background corners

Cards are managed as section blocks for full editorial control.
Badge numbers auto-increment based on block position.
============================================================
{% endcomment %}
<link rel="preload" href="{{ 'custom.css' | asset_url }}" as="style">

{%- liquid
assign s = section.settings
assign sec_id = 'kidsy-steps-' | append: section.id
-%}

<style>
#{{ sec_id }} {
--bg:         {{ s.color_bg        | default: '#FFF4E1' }};
--card-bg:    {{ s.color_card      | default: '#FFFFFF' }};
--card-brd:   {{ s.color_border    | default: 'rgba(52,19,0,0.19)' }};
--text:       {{ s.color_text      | default: '#341300' }};
--accent:     {{ s.color_accent    | default: '#F45901' }};
--badge-bg:   {{ s.color_badge     | default: '#FFDFA8' }};
--blob:       {{ s.color_blob      | default: '#FFE0B0' }};
}

#{{ sec_id }} {
position: relative;
background: var(--bg);
padding: {{ s.padding_top | default: 60 }}px 0 {{ s.padding_bottom | default: 60 }}px;
overflow: hidden;
isolation: isolate;
font-family: "Roobert TRIAL", sans-serif;
color: var(--text);
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
}

#{{ sec_id }} *,
#{{ sec_id }} *::before,
#{{ sec_id }} *::after { box-sizing: border-box; }

#{{ sec_id }} img { display: block; max-width: 100%; }

/* ============================================================
DECORATIVE BLOBS — left and right background shapes
Figma: left blob at left:-239, top:80; right blob at left:1073, top:-22
============================================================ */
#{{ sec_id }} .ks__blob {
position: absolute;
z-index: 1;
pointer-events: none;
opacity: {{ s.blob_opacity | default: 1 }};
}
#{{ sec_id }} .ks__blob--left {
left: -10px;
top: 80px;
transform: rotate(-1.399deg);
}
#{{ sec_id }} .ks__blob--right {
left: auto;
right: 0;
bottom: 0;
}

/* ============================================================
INNER LAYOUT
============================================================ */
#{{ sec_id }} .ks__inner {
position: relative;
display: flex;
flex-direction: column;
align-items: center;
gap: 40px;
z-index: 2;
}

/* Header */
#{{ sec_id }} .ks__header {
max-width: 342px;
width: 100%;
display: flex;
flex-direction: column;
gap: 8px;
align-items: center;
text-align: center;
}
#{{ sec_id }} .ks__title {
margin: 0;
color: var(--text);
font-size: 32px;
font-weight: 600;
text-transform: capitalize;
line-height: 1.1;
}
#{{ sec_id }} .ks__subtitle {
margin: 0;
color: var(--text);
font-size: 16px;
font-weight: 400;
line-height: 1.75;
text-transform: capitalize;
}

/* ============================================================
CARD GRID — 3 columns, 24px gap (Figma exact)
============================================================ */
#{{ sec_id }} .ks__grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 24px;
width: 100%;
}

#{{ sec_id }} .ks__card {
position: relative;
background: var(--card-bg);
border: 1px solid var(--card-brd);
border-radius: 16px;
padding: 20px 32px;
min-height: 373px;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
gap: 32px;
text-align: center;
}

/* Numbered badge — floats above the card top edge */
#{{ sec_id }} .ks__badge {
position: absolute;
top: -25px;
left: 50%;
transform: translateX(-50%);
width: 48px;
height: 48px;
border-radius: 50%;
background: var(--badge-bg);
color: #000;
display: inline-flex;
align-items: center;
justify-content: center;
font-size: 24px;
font-weight: 400;
line-height: 1;
z-index: 3;
}

/* Icon block — orange rounded square holding the SVG/img */
#{{ sec_id }} .ks__icon {
width: 80px;
height: 80px;
border-radius: 10px;
background: var(--accent);
color: #fff;
display: inline-flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}
#{{ sec_id }} .ks__icon svg,
#{{ sec_id }} .ks__icon img {
width: 48px;
height: 48px;
}

/* Card text block */
#{{ sec_id }} .ks__text {
display: flex;
flex-direction: column;
align-items: center;
gap: 16px;
color: var(--text);
}
#{{ sec_id }} .ks__step-title {
margin: 0;
font-size: 18px;
font-weight: 600;
letter-spacing: 0.36px;
text-transform: uppercase;
line-height: 1.1;
color: var(--text);

}
#{{ sec_id }} .ks__step-desc {
margin: 0;
font-size: 16px;
font-weight: 400;
line-height: 1.5;
text-transform: capitalize;
max-width: 100%;
}

/* Primary button */
#{{ sec_id }} .ks__btn {
display: inline-flex;
align-items: center;
justify-content: center;
padding: 15px 20px;
border-radius: 6px;
font-size: 18px;
font-weight: 600;
text-decoration: none;
text-transform: capitalize;
border: none;
cursor: pointer;
line-height: 1;
font-family: inherit;
background: var(--accent);
color: #fff;
white-space: nowrap;
transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
}
#{{ sec_id }} .ks__btn:hover {
transform: translateY(-1px);
box-shadow: 0 8px 20px rgba(52,19,0,.18);
filter: brightness(1.05);
}
.mb_show{
display:none;
}
/* ============================================================
RESPONSIVE
============================================================ */
@media (max-width: 1100px) {
#{{ sec_id }} { padding: 56px 0; }
#{{ sec_id }} .ks__grid { gap: 20px; }
#{{ sec_id }} .ks__card { padding: 20px 24px; }
#{{ sec_id }} .ks__blob--left  { left: -300px; opacity: 0.7; }
#{{ sec_id }} .ks__blob--right { right: -340px; opacity: 0.7; }
}

@media (max-width: 900px) {
#{{ sec_id }} .ks__grid {
grid-template-columns: 1fr;
max-width: 480px;
margin: 0 auto;
gap: 40px;
}
.desktop_show{
display:none;
}
.mb_show{
display:block;
}
#{{ sec_id }} .ks__card { min-height: auto; padding: 28px 24px; }
#{{ sec_id }} .ks__blob--left  { width: 380px; height: 340px; left: -180px; opacity: 0.5; display:none; }
#{{ sec_id }} .ks__blob--right { 
opacity: 1;
        width: 331.065px;
        height: 292.774px;
        top: 115px;
        right: -104px;

}
}

@media (max-width: 768px) {
#{{ sec_id }} { padding: 40px 0; }
#{{ sec_id }} .page-width{
padding:0 16px;
}
#{{ sec_id }} .ks__inner { gap: 40px; }
#{{ sec_id }} .ks__title { 
font-size: 24px;
font-style: normal;
font-weight: 650;
line-height: normal;
text-transform: capitalize;
}
#{{ sec_id }} .ks__subtitle { 
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-transform: capitalize;

}
#{{ sec_id }} .ks__grid { gap: 36px; }
#{{ sec_id }} .ks__card { padding: 32px 16px;
flex-direction: column;
justify-content: center;
align-items: center;
gap: 32px; }
#{{ sec_id }} .ks__icon { width: 56px; height: 56px; }
#{{ sec_id }} .ks__icon svg,
#{{ sec_id }} .ks__icon img { width: 40px; height: 40px; }
#{{ sec_id }} .ks__step-desc {
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-transform: capitalize;
}
#{{ sec_id }} .ks__btn { 
display: flex;
padding: 15px 20px;
justify-content: center;
align-items: center;
gap: 10px;
font-size: 18px;
font-style: normal;
font-weight: 650;
line-height: 100%; /* 18px */
text-transform: capitalize;

}
#{{ sec_id }} .ks__badge { width: 42px; height: 42px; top: -21px;
font-size: 24px;
font-style: normal;
font-weight: 400;
line-height: normal;
}
#{{ sec_id }}  .ks__step-title {
font-size: 16px;
font-style: normal;
font-weight: 650;
line-height: normal;
letter-spacing: 0.32px;
text-transform: uppercase;
}
#{{ sec_id }}  .ks__text {
    gap: 12px;
}
}
</style>

<section
id="{{ sec_id }}"
class="kidsy-steps"
aria-labelledby="{{ sec_id }}-title">
{%- comment -%} Decorative blobs — left and right corners {%- endcomment -%}
{%- if s.show_blobs -%}
{%- if s.blob_image != blank -%}
<img class="ks__blob ks__blob--left"  src="{{ s.blob_image | image_url: width: 1000 }}" alt="" aria-hidden="true" loading="lazy">
<img class="ks__blob ks__blob--right" src="{{ s.blob_image | image_url: width: 1000 }}" alt="" aria-hidden="true" loading="lazy">
{%- else -%}

<svg xmlns="http://www.w3.org/2000/svg" width="331" height="506" viewBox="0 0 331 506" fill="none" class="ks__blob ks__blob--left" >
<path d="M-231.163 202.836C-248.294 360.517 -63.2088 456.99 -49.2673 464.003C80.9507 529.488 268.142 516.533 316.672 427.015C343.951 376.694 329.197 298.891 293.882 282.925C244.537 260.612 188.187 326.012 150.925 304.418C120.734 286.922 96.2306 262.692 68.869 167.674C51.499 107.361 50.2614 12.3737 -23.1683 1.22747C-114.948 -12.6995 -219.364 94.223 -231.163 202.836Z" fill="#FFDFA8"/>
</svg>
<svg xmlns="http://www.w3.org/2000/svg" width="205" height="580" viewBox="0 0 205 580" fill="none"  class="ks__blob ks__blob--right desktop_show">
<path d="M431.624 477.198C522.144 346.957 405.823 173.657 396.94 160.826C313.958 40.997 143.405 -37.2355 57.9452 18.1289C9.90601 49.2525 -14.3829 124.624 8.98012 155.547C41.623 198.759 122.405 168.313 144.783 205.109C162.914 234.922 172.83 267.925 151.369 364.447C137.748 425.716 93.3652 509.706 152.5 554.642C226.414 610.804 369.272 566.91 431.624 477.198Z" fill="#FFDFA8"/>
</svg>
<svg xmlns="http://www.w3.org/2000/svg" width="139" height="339" viewBox="0 0 139 339" fill="none" class="ks__blob ks__blob--right mb_show">
<path d="M252.238 278.871C305.137 202.759 237.16 101.484 231.969 93.9855C183.474 23.9584 83.8048 -21.7601 33.8627 10.5945C5.78896 28.7828 -8.40528 72.8296 5.24789 90.9007C24.3241 116.153 71.5323 98.3607 84.6101 119.864C95.2059 137.287 101 156.574 88.4587 212.98C80.4988 248.785 54.5619 297.868 89.1196 324.129C132.315 356.949 215.8 331.298 252.238 278.871Z" fill="#FFDFA8"/>
</svg>
{%- endif -%}
{%- endif -%}
<div class="page-width">


<div class="ks__inner">

{%- comment -%} Header {%- endcomment -%}
{%- if s.title != blank or s.subtitle != blank -%}
<header class="ks__header">
{%- if s.title != blank -%}
<h2 id="{{ sec_id }}-title" class="ks__title">{{ s.title }}</h2>
{%- endif -%}
{%- if s.subtitle != blank -%}
<p class="ks__subtitle">{{ s.subtitle }}</p>
{%- endif -%}
</header>
{%- endif -%}

{%- comment -%} Step cards — managed via blocks {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="ks__grid" role="list">
{%- for block in section.blocks -%}
{%- if block.type == 'step' -%}
{%- assign b = block.settings -%}
{%- assign step_num = forloop.index -%}
<article class="ks__card" role="listitem" {{ block.shopify_attributes }}>

{%- if s.show_numbers -%}
<span class="ks__badge" aria-label="Step {{ step_num }}">{{ step_num }}</span>
{%- endif -%}

<div class="ks__icon">
{%- if b.icon_image != blank -%}
<img src="{{ b.icon_image | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
{%- else -%}
{%- case b.icon_preset -%}

{%- when 'users' -%}
{%- comment -%} Join free — group of people {%- endcomment -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<circle cx="24" cy="18" r="6" stroke="currentColor" stroke-width="2.4"/>
<path d="M12 38c0-6.6 5.4-12 12-12s12 5.4 12 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
<circle cx="10" cy="20" r="4" stroke="currentColor" stroke-width="2.2"/>
<circle cx="38" cy="20" r="4" stroke="currentColor" stroke-width="2.2"/>
<path d="M2 36c0-4.4 3.6-8 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
<path d="M46 36c0-4.4-3.6-8-8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
</svg>

{%- when 'shop' -%}
{%- comment -%} Shop & earn — storefront {%- endcomment -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<path d="M8 18h32v22a2 2 0 01-2 2H10a2 2 0 01-2-2V18z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
<path d="M6 18l4-10h28l4 10" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
<path d="M16 18a4 4 0 11-8 0M24 18a4 4 0 11-8 0M32 18a4 4 0 11-8 0M40 18a4 4 0 11-8 0" stroke="currentColor" stroke-width="2.2"/>
<rect x="20" y="28" width="8" height="14" stroke="currentColor" stroke-width="2.2"/>
</svg>

{%- when 'check_badge' -%}
{%- comment -%} Redeem — checkmark in scalloped badge {%- endcomment -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<path d="M24 4l3.6 3 4.6-.7 1.6 4.4 4.4 1.6-.7 4.6 3 3.6-3 3.6.7 4.6-4.4 1.6-1.6 4.4-4.6-.7-3.6 3-3.6-3-4.6.7-1.6-4.4-4.4-1.6.7-4.6-3-3.6 3-3.6-.7-4.6 4.4-1.6 1.6-4.4 4.6.7L24 4z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
<path d="M16 24l6 6 12-12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

{%- when 'gift' -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<rect x="6" y="18" width="36" height="24" rx="2" stroke="currentColor" stroke-width="2.4"/>
<rect x="4" y="12" width="40" height="8" rx="1" stroke="currentColor" stroke-width="2.4"/>
<line x1="24" y1="12" x2="24" y2="42" stroke="currentColor" stroke-width="2.4"/>
<path d="M24 12c-4-6-10-6-10-2s4 2 10 2zM24 12c4-6 10-6 10-2s-4 2-10 2z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
</svg>

{%- when 'star' -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<path d="M24 4l6.4 13 14.4 2.1-10.4 10.1 2.4 14.3L24 36.8 11.2 43.5l2.4-14.3L3.2 19.1 17.6 17 24 4z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
</svg>

{%- when 'cart' -%}
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<path d="M4 6h6l4 24h26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M14 14h28l-3 14H17" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
<circle cx="18" cy="40" r="3" stroke="currentColor" stroke-width="2.2"/>
<circle cx="36" cy="40" r="3" stroke="currentColor" stroke-width="2.2"/>
</svg>

{%- endcase -%}
{%- endif -%}
</div>

<div class="ks__text">
{%- if b.title != blank -%}
<h3 class="ks__step-title">{{ b.title }}</h3>
{%- endif -%}
{%- if b.description != blank -%}
<p class="ks__step-desc">{{ b.description }}</p>
{%- endif -%}
</div>

{%- if b.btn_label != blank -%}
<a href="{{ b.btn_link | default: '#' }}" class="ks__btn">{{ b.btn_label }}</a>
{%- endif -%}

</article>
{%- endif -%}
{%- endfor -%}
</div>
{%- endif -%}
</div>
</div>
</section>

{% schema %}
{
"name": "Three Steps to Savings",
"tag": "section",
"class": "section-kidsy-steps",
"settings": [
{
"type": "header",
"content": "Section Heading"
},
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Three Steps to Savings"
},
{
"type": "text",
"id": "subtitle",
"label": "Subtitle",
"default": "Start earning in under 30 seconds."
},

{
"type": "header",
"content": "Step Numbering"
},
{
"type": "checkbox",
"id": "show_numbers",
"label": "Show numbered badges",
"default": true,
"info": "Auto-numbered 1, 2, 3 based on card order"
},

{
"type": "header",
"content": "Background Decoration"
},
{
"type": "checkbox",
"id": "show_blobs",
"label": "Show decorative blobs",
"default": true
},
{
"type": "image_picker",
"id": "blob_image",
"label": "Custom blob image (optional)",
"info": "Defaults to a built-in cream shape"
},
{
"type": "range",
"id": "blob_opacity",
"label": "Blob opacity",
"min": 0, "max": 1, "step": 0.1,
"default": 1
},

{
"type": "header",
"content": "Spacing"
},
{
"type": "range",
"id": "padding_top",
"label": "Top padding",
"min": 0, "max": 160, "step": 4, "unit": "px",
"default": 60
},
{
"type": "range",
"id": "padding_bottom",
"label": "Bottom padding",
"min": 0, "max": 160, "step": 4, "unit": "px",
"default": 60
},

{
"type": "header",
"content": "Colors"
},
{
"type": "color",
"id": "color_bg",
"label": "Section background",
"default": "#FFF4E1"
},
{
"type": "color",
"id": "color_card",
"label": "Card background",
"default": "#FFFFFF"
},
{
"type": "color",
"id": "color_border",
"label": "Card border",
"default": "#574030"
},
{
"type": "color",
"id": "color_text",
"label": "Text",
"default": "#341300"
},
{
"type": "color",
"id": "color_accent",
"label": "Accent (icons & buttons)",
"default": "#F45901"
},
{
"type": "color",
"id": "color_badge",
"label": "Number badge background",
"default": "#FFDFA8"
},
{
"type": "color",
"id": "color_blob",
"label": "Blob color (built-in)",
"default": "#FFE0B0"
}
],
"blocks": [
{
"type": "step",
"name": "Step",
"limit": 6,
"settings": [
{
"type": "text",
"id": "title",
"label": "Step title",
"default": "Join Free"
},
{
"type": "textarea",
"id": "description",
"label": "Description",
"default": "Create a Kidsy account in 30 seconds. No credit card, no fees. You'll get 100 bonus points immediately when your account is confirmed."
},
{
"type": "select",
"id": "icon_preset",
"label": "Icon preset",
"options": [
{ "value": "users",       "label": "Users (Join)" },
{ "value": "shop",        "label": "Shop (Storefront)" },
{ "value": "check_badge", "label": "Check badge (Redeem)" },
{ "value": "gift",        "label": "Gift" },
{ "value": "star",        "label": "Star" },
{ "value": "cart",        "label": "Cart" }
],
"default": "users"
},
{
"type": "image_picker",
"id": "icon_image",
"label": "Custom icon (optional)",
"info": "Overrides the preset. White-on-transparent works best."
},
{
"type": "header",
"content": "Button"
},
{
"type": "text",
"id": "btn_label",
"label": "Button text",
"default": "Create Account"
},
{
"type": "url",
"id": "btn_link",
"label": "Button link"
}
]
}
],
"presets": [
{
"name": "Three Steps to Savings",
"blocks": [
{
"type": "step",
"settings": {
"title": "Join Free",
"description": "Create a Kidsy account in 30 seconds. No credit card, no fees. You'll get 100 bonus points immediately when your account is confirmed.",
"icon_preset": "users",
"btn_label": "Create Account"
}
},
{
"type": "step",
"settings": {
"title": "Shop & Earn",
"description": "Every $1 spent earns points — more as you climb tiers. Browse open-box deals from Graco, UPPAbaby, Chicco, and 100+ premium brands.",
"icon_preset": "shop",
"btn_label": "Shop Now"
}
},
{
"type": "step",
"settings": {
"title": "Redeem at Checkout",
"description": "Apply your points for instant $ off at checkout. Stack with sitewide sales for maximum savings on every order.",
"icon_preset": "check_badge",
"btn_label": "Redeem Points"
}
}
]
}
]
}
{% endschema %}
