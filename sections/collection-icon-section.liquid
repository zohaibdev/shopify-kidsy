<style>
  #shopify-section-{{ section.id }} .collection-icon-section .img_text h2 { margin: 0 0 0 46px; font-size: 48px; font-weight: 500; line-height: 1.25; font-family: 'Poppins'; letter-spacing: 0; } #shopify-section-{{ section.id }} .collection-icon-section .container { margin: 0 auto; max-width: 1380px; padding: 0; } #shopify-section-{{ section.id }} .collection-icon-section .image_blog { display: flex; align-items: center; background-color: #f7b801; border: 1px solid; border-radius: 25px; padding: 11px; gap: 20px; justify-content: space-between; } #shopify-section-{{ section.id }} .collection-icon-section .svg_blog { display: flex; gap: 41px; margin-top: 4px; } #shopify-section-{{ section.id }} .collection-icon-section  { padding: 18px 30px; } @media only screen and (max-width: 1200px) { #shopify-section-{{ section.id }} .collection-icon-section .blog img { width: 115px; height: 115px; } #shopify-section-{{ section.id }} .collection-icon-section .img_text h2 { font-size: 38px; } } @media only screen and (max-width: 768px) { #shopify-section-{{ section.id }} .collection-icon-section .img_text h2 { margin: 0; font-size: 18px; } #shopify-section-{{ section.id }} .collection-icon-section .image_blog { padding: 10px; gap: 0px; border-radius: 15px; } #shopify-section-{{ section.id }} .collection-icon-section .blog img { width: 75px; height: 75px; object-fit: contain; } #shopify-section-{{ section.id }} .collection-icon-section .svg_blog { display: flex; gap: 0; margin-top: 0; } #shopify-section-{{ section.id }} .collection-icon-section  { padding: 9px 6px; } }
</style>
<section class="collection-icon-section" style="background-color:{{ section.settings.bg_color }};">
        <div class="container">
            <div class="image_blog">
                <div class="img_text">
                  {% if collection.handle == 'all' %}
                    <h2> {{ section.settings.heading }}</h2>
                  {% else %}
                    <h2>{{ collection.title }}</h2>
                  {% endif %}
                </div>
                <div class="svg_blog">
                  {% if section.settings.svg_img != blank %}
                    <div class="blog">
                        <img src="{{ section.settings.svg_img | image_url }}" alt="{{section.settings.heading }}"
                            width="{{ section.settings.svg_img.width }}" height="{{ section.settings.svg_img.height }}"
                            loading="lazy" />
                    </div>
                  {% endif %}
                   {% if section.settings.svg_img1 != blank %}
                    <div class="blog">
                        <img src="{{ section.settings.svg_img1 | image_url }}" alt="{{section.settings.heading }}"
                            width="{{ section.settings.svg_img.width }}" height="{{ section.settings.svg_img.height }}"
                            loading="lazy" />
                    </div>
                  {% endif %}
                   {% if section.settings.svg_img2 != blank %}
                    <div class="blog">
                        <img src="{{ section.settings.svg_img2 | image_url }}" alt="{{section.settings.heading }}"
                            width="{{ section.settings.svg_img.width }}" height="{{ section.settings.svg_img.height }}"
                            loading="lazy" />
                    </div>
                  {% endif %}
                </div>
            </div>
        </div>
    </section>
{% schema %}
  {
    "name": "Collection Icon Section",
    "settings": [
      {
      "type": "text",
      "id": "heading",
      "label": "Add Heading"
    },
       {
        "type": "color",
        "id":"bg_color",
        "label":"Select Background Color",
      },
      {
        "type": "image_picker",
        "id":"svg_img",
        "label": "Select Svg Image"
    },
      {
        "type": "image_picker",
        "id":"svg_img1",
        "label": "Select Svg Image"
    },
      {
        "type": "image_picker",
        "id":"svg_img2",
        "label": "Select Svg Image"
    },
    ],
  "presets": [
    {
      "name": "Collection Icon Section"
    }
  ],
  }
{% endschema %}