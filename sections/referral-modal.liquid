      </div>

      <div class="krc__content">

        <div class="krc__top">

          <div class="krc__heading">
            {%- if s.title != blank -%}
              <h2 id="{{ sec_id }}-title" class="krc__title">{{ s.title }}</h2>
            {%- endif -%}
            {%- if s.subtitle != blank -%}
              <p class="krc__subtitle">{{ s.subtitle }}</p>
            {%- endif -%}
          </div>

          <a
            href="{{ s.cta_link | default: '#smile-referral-program-details' }}"
            class="krc__submit"
            style="width:auto;min-width:220px;padding-left:32px;padding-right:32px;text-decoration:none;">
            {{ s.cta_label | default: 'Get Started' }}
          </a>

        </div>

      </div>
    </div>
  </div>
</section>



{% schema %}
{
  "name": "Referral Card",
  "tag": "section",
  "class": "section-kidsy-referral-card",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get Your Referral Link"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Sign in or enter your email to claim your unique link instantly."
    },

    {
      "type": "header",
      "content": "Email Form"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button text",
      "default": "Get My Link"
    },
    {
      "type": "text",
      "id": "loading_label",
      "label": "Loading text",
      "default": "Generating…"
    },
    {
      "type": "text",
      "id": "success_label",
      "label": "Success text",
      "default": "Link ready ✓"
    },
    {
      "type": "url",
      "id": "form_action",
      "label": "Form submit URL (optional)",
      "info": "If set, form posts to this URL. Otherwise uses JS demo handler."
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "Fallback referral link"
    },

    {
      "type": "header",
      "content": "Divider & Login"
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "Divider text",
      "default": "— or —"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Login button text",
      "default": "Log In to My Account"
    },
    {
      "type": "url",
      "id": "login_link",
      "label": "Login link"
    },

    {
      "type": "header",
      "content": "Share Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons row",
      "default": true
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy button label",
      "default": "Copy Link"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "Copied confirmation",
      "default": "Copied!"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email button label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "share_email_subject",
      "label": "Email share subject",
      "default": "Save on baby gear with Kidsy"
    },
    {
      "type": "textarea",
      "id": "share_email_body",
      "label": "Email share body",
      "default": "Hey — I shop on Kidsy for premium baby gear at way below retail. Use my link and we both save: "
    },
    {
      "type": "text",
      "id": "text_label",
      "label": "Text button label",
      "default": "Text"
    },
    {
      "type": "textarea",
      "id": "share_text_body",
      "label": "SMS share body",
      "default": "Hey — I shop on Kidsy for baby gear deals. Use my link and we both save: "
    },
    {
      "type": "text",
      "id": "share_aria_label",
      "label": "Share group aria-label",
      "default": "Share your referral link"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_outer",
      "label": "Section outer padding",
      "min": 0, "max": 80, "step": 5, "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "frame_min_height",
      "label": "Frame minimum height",
      "min": 400, "max": 900, "step": 20, "unit": "px",
      "default": 600
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_outer_bg",
      "label": "Page background (around frame)",
      "default": "#FFFBF3"
    },
    {
      "type": "color",
      "id": "color_frame",
      "label": "Frame (orange)",
      "default": "#F45901"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Inner card (soft gold)",
      "default": "#FFDFA8"
    },
    {
      "type": "color",
      "id": "color_blob",
      "label": "Decorative blobs",
      "default": "#FFDFA8"
    },
    {
      "type": "color",
      "id": "color_squiggle",
      "label": "Orange squiggle",
      "default": "#F45901"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#341300"
    },
    {
      "type": "color",
      "id": "color_submit",
      "label": "Submit button",
      "default": "#FFBC38"
    },
    {
      "type": "color",
      "id": "color_login",
      "label": "Login button",
      "default": "#FFBF41"
    },
    {
      "type": "color",
      "id": "color_share",
      "label": "Share buttons background",
      "default": "#FFF4E1"
    },
