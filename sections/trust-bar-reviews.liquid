{% comment %}
  ============================================================
  Section: Trust Bar + Review Slider
  ------------------------------------------------------------
  Three-part social proof section matching Figma design:
    1. White pill at top with 3 trust points (icon + text)
    2. Row of 4 trust badges (orange icon block + title + body)
    3. Review carousel with prev/next arrow controls

  The slider is a proper carousel:
    • Snap-scroll between cards (smooth horizontal slide)
    • Prev/next arrow buttons (active state on the right by default)
    • Keyboard arrow-key navigation when focused
    • Touch / swipe support via native scroll-snap
    • ARIA live region announces current slide
    • Buttons disable at endpoints

  All trust points, badges, and reviews are managed as section
  blocks with their own typed schemas.
  ============================================================
{% endcomment %}
 <link rel="preload" href="{{ 'custom.css' | asset_url }}" as="style">

{%- liquid
  assign s = section.settings
  assign sec_id = 'kidsy-social-' | append: section.id

  assign trust_points = section.blocks | where: 'type', 'trust_point'
  assign trust_badges = section.blocks | where: 'type', 'trust_badge'
  assign reviews      = section.blocks | where: 'type', 'review'
-%}

<style>
  #{{ sec_id }} {
    --bg-from:    {{ s.color_bg_from   | default: '#FFDFA8' }};
    --bg-to:      {{ s.color_bg_to     | default: 'rgba(255,223,168,0)' }};
    --text:       {{ s.color_text      | default: '#341300' }};
    --accent:     {{ s.color_accent    | default: '#F45901' }};
    --card-bg:    {{ s.color_card      | default: '#FFFFFF' }};
    --border:     {{ s.color_border    | default: 'rgba(52,19,0,0.19)' }};
    --star:       {{ s.color_star      | default: '#FFBC38' }};
    --avatar-bg:  {{ s.color_avatar_bg | default: '#FDDECC' }};
  }

  #{{ sec_id }} {
background: linear-gradient(180deg, #FFDFA8 0%, rgba(255, 223, 168, 0.00) 100%);
    padding: {{ s.padding_bottom | default: 60 }}px 0px {{ s.padding_bottom | default: 60 }}px;
    font-family: "Roobert TRIAL", sans-serif;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #{{ sec_id }} img { display: block; max-width: 100%; }
  #{{ sec_id }} ul  { list-style: none; padding: 0; margin: 0; }

  #{{ sec_id }} .ks__inner {
    display: flex;
    flex-direction: column;
    gap: 80px;
    align-items: center;
  }

  /* ============================================================
     TRUST PILL — white rounded pill at top with 3 points
     ============================================================ */
  #{{ sec_id }} .ks__top {
    width: 100%;
    {% comment %} padding: 60px 40px 0; {% endcomment %}
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  #{{ sec_id }} .ks__pill {
    background: var(--card-bg);
    border-radius: 40px;
    padding: 10px 12px;
    display: inline-flex;
    align-items: center;
    gap: 13px;
    flex-wrap: wrap;
    justify-content: center;
  }

  #{{ sec_id }} .ks__pill-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    text-transform: capitalize;
    line-height: 1;
  }
  #{{ sec_id }} .ks__pill-item svg,
  #{{ sec_id }} .ks__pill-item img {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--accent);
  }

  /* ============================================================
     TRUST BADGES ROW — 4 badges with orange icon blocks
     ============================================================ */
  #{{ sec_id }} .ks__badges {
    width: 100%;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
  }

  #{{ sec_id }} .ks__badge-item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    text-align: center;
    color: var(--text);
    max-width: 317px;
  }

  #{{ sec_id }} .ks__badge-icon {
    width: 60px;
    height: 60px;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #{{ sec_id }} .ks__badge-icon svg,
  #{{ sec_id }} .ks__badge-icon img {
    width: 40px;
    height: 40px;
  }

  #{{ sec_id }} .ks__badge-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
       width: 100%;
    min-width: 319px;
  }

  #{{ sec_id }} .ks__badge-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.32px;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--text);
  }
  #{{ sec_id }} .ks__badge-desc {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: capitalize;
  }

  /* ============================================================
     REVIEW SLIDER
     ============================================================ */
  #{{ sec_id }} .ks__slider {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* The track is a horizontal scroll container with snap points.
     Each slide is a flex item taking 100% of the visible track width.
     This gives us free swipe + scroll-snap + smooth scrollTo() control. */
  #{{ sec_id }} .ks__track {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    display: flex;
    gap: 0;
    /* Hide scrollbar across browsers */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #{{ sec_id }} .ks__track::-webkit-scrollbar { display: none; }

  #{{ sec_id }} .ks__slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #{{ sec_id }} .ks__card {
    background: var(--card-bg);
    border: 1px solid rgba(52, 19, 0, 0.19);
    border-radius: 6px;
    padding: 20px;
    height: 308px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ sec_id }} .ks__card-inner {
    width: 100%;
    max-width: 681px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    justify-content: center;
  }

  /* Star rating */
  #{{ sec_id }} .ks__stars {
    display: flex;
    align-items: center;
    gap: 0;
    color: var(--star);
    height: 20px;
    align-self: flex-start;
  }
  #{{ sec_id }} .ks__stars svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Review body */
  #{{ sec_id }} .ks__review-body {
    width: 100%;
    height: 140px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
    overflow: hidden;
  }
  #{{ sec_id }} .ks__review-title {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: capitalize;
    color: var(--text);
  }
  #{{ sec_id }} .ks__review-text {
    margin: 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.45;
    color: var(--text);
    {% comment %} /* Clamp to fit the 140px body — falls back to overflow:hidden on older browsers */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden; {% endcomment %}
  }

  /* Divider */
  #{{ sec_id }} .ks__divider {
    width: 100%;
    height: 1px;
    background: rgba(52, 19, 0, 0.19);
    display: block;
  }

  /* Reviewer row */
  #{{ sec_id }} .ks__reviewer {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #{{ sec_id }} .ks__avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--avatar-bg);
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.36px;
    text-transform: uppercase;
    overflow: hidden;
  }
  #{{ sec_id }} .ks__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #{{ sec_id }} .ks__reviewer-info {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
  }
  #{{ sec_id }} .ks__reviewer-name {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    text-transform: capitalize;
    line-height: 1;
  }
  #{{ sec_id }} .ks__verified {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 16px;
    font-weight: 400;
    text-transform: capitalize;
    line-height: 1;
  }
  #{{ sec_id }} .ks__verified svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* ============================================================
     SLIDER CONTROLS — prev/next round buttons
     ============================================================ */
  #{{ sec_id }} .ks__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  #{{ sec_id }} .ks__nav {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background .18s ease, color .18s ease, transform .15s ease, opacity .18s ease;
    font-family: inherit;
  }
  #{{ sec_id }} .ks__nav:hover:not(:disabled) {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
  #{{ sec_id }} .ks__nav.is-active {
    background: var(--accent);
    color: #fff;
        border: transparent;
  }
    #{{ sec_id }} .ks__nav.is-active svg path {
    stroke: #fff;
    }
  #{{ sec_id }} .ks__nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
    #{{ sec_id }} .ks__nav:disabled svg path {
    stroke: #000;
    }
  #{{ sec_id }} .ks__nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Visually-hidden helper for screen readers */
  #{{ sec_id }} .ks__sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1100px) {
    #{{ sec_id }} { padding: 56px 0; }
    {% comment %} #{{ sec_id }} .ks__top { padding: 48px 0 0; } {% endcomment %}
    #{{ sec_id }} .ks__badges { gap: 20px; }
    #{{ sec_id }} .ks__badge-text {
    min-width: auto;
  }
  }

  @media (max-width: 900px) {
    #{{ sec_id }} .ks__pill { gap: 12px; padding: 12px 16px; }
    #{{ sec_id }} .ks__pill-item { font-size: 12px;
        gap: 4px; }
    #{{ sec_id }} .ks__badges {
      flex-wrap: wrap;
      gap: 28px 16px;
      justify-content: center;
    }
    #{{ sec_id }} .ks__badge-item { flex: 0 0 calc(50% - 8px); max-width: none; }
  }

  @media (max-width: 768px) {
    #{{ sec_id }} { padding:20px 0; }
    {% comment %} #{{ sec_id }} .ks__top { padding: 40px 0 0; gap: 20px; } {% endcomment %}
    #{{ sec_id }} .ks__pill {
      border-radius: 24px;
      padding: 10px 14px;
      align-items: flex-start;
      gap: 8px;
              max-width: 343px;
        width: 100%;
                flex-wrap: wrap;
        justify-content: center;
    }
        #{{ sec_id }} .page-width{
padding:0 16px;
}
  #{{ sec_id }} .ks__pill { border-radius: 40px;
    padding: 10px 8px;
gap: 10px;
 }
    #{{ sec_id }} .ks__badges {           flex-wrap: wrap;
        gap: 8px;
        align-items: center; }
    #{{ sec_id }} .ks__badge-item {         flex: 0 0 167px;
        max-width: 167px; }
          #{{ sec_id }}  .ks__badge-icon {
    width: 56px;
    height: 56px;
        }
           #{{ sec_id }} .ks__badge-title {
font-size: 14px;
font-style: normal;
font-weight: 650;
line-height: normal;
letter-spacing: 0.28px;
text-transform: uppercase;
}
  #{{ sec_id }}  .ks__badge-desc {
    font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: normal;
text-transform: capitalize;
}
 #{{ sec_id }} .ks__inner {
    gap: 20px;
}
#{{ sec_id }}  .ks__card-inner {
    gap: 10px;
}
    #{{ sec_id }} .ks__review-title { font-size: 18px;
font-style: normal;
font-weight: 650;
line-height: normal;
text-transform: capitalize; }
    #{{ sec_id }} .ks__review-text {
    font-size: 16px;
font-style: normal;
font-weight: 400;
line-height: normal;
    
    }
    #{{ sec_id }} .ks__nav { width: 30px; height: 30px; }
    #{{ sec_id }} .ks__nav svg { width: 18px; height: 18px; }
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    #{{ sec_id }} .ks__track { scroll-behavior: auto; }
    #{{ sec_id }} .ks__nav { transition: none; }
  }
</style>

<section
  id="{{ sec_id }}"
  class="kidsy-social"
  aria-labelledby="{{ sec_id }}-label">
  <span id="{{ sec_id }}-label" class="ks__sr-only">Customer reviews and trust signals</span>
  <div class="page-width">

  <div class="ks__inner">

    {%- comment -%} =====================================================
                    TOP — pill + trust badges
                    ===================================================== {%- endcomment -%}
    <div class="ks__top">

      {%- comment -%} White trust pill with 3 points {%- endcomment -%}
      {%- if trust_points.size > 0 -%}
        <ul class="ks__pill" role="list">
          {%- for block in trust_points -%}
            {%- assign tp = block.settings -%}
            <li class="ks__pill-item" {{ block.shopify_attributes }}>
              {%- if tp.icon != blank -%}
                <img src="{{ tp.icon | image_url: width: 36 }}" alt="" width="18" height="18" loading="lazy">
              {%- else -%}
                {%- case tp.icon_preset -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M5.4 9.2L8 11.6l4.8-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 18 18" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M9 1.5l2.4 4.9 5.4.8-3.9 3.8.9 5.4L9 13.9l-4.8 2.5.9-5.4L1.2 7.2l5.4-.8L9 1.5z"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect x="2.5" y="7" width="13" height="9" rx="1" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="1.5" y="5" width="15" height="2.5" rx="0.5" stroke="currentColor" stroke-width="1.5"/>
                      <line x1="9" y1="5" x2="9" y2="16" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M9 5C7.7 3 5.5 3 5.5 4.4c0 0.9 1.3 1.1 3.5 0.6zM9 5c1.3-2 3.5-2 3.5-0.6 0 0.9-1.3 1.1-3.5 0.6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M9 1.5l6 2.4v4.4c0 4-2.6 6.7-6 8-3.4-1.3-6-4-6-8V3.9l6-2.4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
              <span>{{ tp.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} 4 trust badges row {%- endcomment -%}
      {%- if trust_badges.size > 0 -%}
        <ul class="ks__badges" role="list">
          {%- for block in trust_badges -%}
            {%- assign tb = block.settings -%}
            <li class="ks__badge-item" {{ block.shopify_attributes }}>
              <div class="ks__badge-icon" aria-hidden="true">
                {%- if tb.icon != blank -%}
                  <img src="{{ tb.icon | image_url: width: 80 }}" alt="" width="40" height="40" loading="lazy">
                {%- else -%}
                  {%- case tb.icon_preset -%}
                    {%- when 'users' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="20" cy="15" r="5" stroke="currentColor" stroke-width="2"/>
                        <path d="M10 32c0-5.5 4.5-10 10-10s10 4.5 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="8" cy="17" r="3.3" stroke="currentColor" stroke-width="1.8"/>
                        <circle cx="32" cy="17" r="3.3" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M2 30c0-3.7 3-6.7 6.7-6.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M38 30c0-3.7-3-6.7-6.7-6.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 4l5.4 11 12 1.7-8.7 8.5 2 12L20 31.5 9.3 37.2l2-12L2.6 16.7l12-1.7L20 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 4l13 5v9c0 9-5.7 14.5-13 17.5C12.7 32.5 7 27 7 18V9l13-5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M14 20l4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'check_badge' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 3l3 2.5 3.8-.6 1.4 3.6 3.6 1.4-.6 3.8 2.5 3-2.5 3 .6 3.8-3.6 1.4-1.4 3.6-3.8-.6-3 2.5-3-2.5-3.8.6-1.4-3.6L4 26.4l.6-3.8-2.5-3 2.5-3-.6-3.8 3.6-1.4 1.4-3.6 3.8.6 3-2.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M14 20l4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'gift' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="5" y="15" width="30" height="20" rx="1.5" stroke="currentColor" stroke-width="2"/>
                        <rect x="3" y="10" width="34" height="6.5" rx="0.8" stroke="currentColor" stroke-width="2"/>
                        <line x1="20" y1="10" x2="20" y2="35" stroke="currentColor" stroke-width="2"/>
                        <path d="M20 10c-3.5-5-8.5-5-8.5-1.5 0 1.8 2.5 2.2 8.5 1.5zM20 10c3.5-5 8.5-5 8.5-1.5 0 1.8-2.5 2.2-8.5 1.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 34S4 26 4 14a8 8 0 0114-5.2A8 8 0 0136 14c0 12-16 20-16 20z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <div class="ks__badge-text">
                <h3 class="ks__badge-title">{{ tb.title }}</h3>
                {%- if tb.description != blank -%}
                  <p class="ks__badge-desc">{{ tb.description }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>

    {%- comment -%} =====================================================
                    REVIEW SLIDER
                    ===================================================== {%- endcomment -%}
    {%- if reviews.size > 0 -%}
      <div
        class="ks__slider"
        data-slider
        data-slide-count="{{ reviews.size }}">

        <div
          class="ks__track"
          data-track
          role="region"
          aria-roledescription="carousel"
          aria-label="Customer reviews"
          tabindex="0">

          {%- for block in reviews -%}
            {%- assign r = block.settings -%}
            {%- assign rating = r.rating | default: 5 | plus: 0 -%}
            <div
              class="ks__slide"
              role="group"
              aria-roledescription="slide"
              aria-label="Review {{ forloop.index }} of {{ reviews.size }}"
              data-slide="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}>

              <article class="ks__card">
                <div class="ks__card-inner">

                  {%- if rating > 0 -%}
                    <div class="ks__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="16" viewBox="0 0 17 16" fill="none">
                    <path d="M7.20985 0.594188C7.46721 -0.197915 8.58783 -0.197915 8.8452 0.594187L10.1508 4.61248C10.2659 4.96672 10.596 5.20656 10.9685 5.20656H15.1936C16.0264 5.20656 16.3727 6.27233 15.6989 6.76187L12.2808 9.24531C11.9794 9.46425 11.8533 9.85231 11.9684 10.2066L13.2741 14.2248C13.5314 15.0169 12.6248 15.6756 11.951 15.1861L8.53287 12.7026C8.23154 12.4837 7.8235 12.4837 7.52217 12.7026L4.10401 15.1861C3.4302 15.6756 2.52361 15.017 2.78098 14.2248L4.0866 10.2066C4.2017 9.85231 4.07561 9.46425 3.77427 9.24531L0.356109 6.76187C-0.317694 6.27233 0.0285943 5.20656 0.86146 5.20656H5.08655C5.45901 5.20656 5.78912 4.96672 5.90422 4.61248L7.20985 0.594188Z" fill="#FFBC38"/>
                    </svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <div class="ks__review-body">
                    {%- if r.title != blank -%}
                      <h3 class="ks__review-title">{{ r.title }}</h3>
                    {%- endif -%}
                    {%- if r.body != blank -%}
                      <p class="ks__review-text">{{ r.body }}</p>
                    {%- endif -%}
                  </div>

                  <div class="ks__divider" aria-hidden="true"></div>

                  <div class="ks__reviewer">
                    <div class="ks__avatar" aria-hidden="true">
                      {%- if r.avatar != blank -%}
                        <img src="{{ r.avatar | image_url: width: 100 }}" alt="" width="50" height="50" loading="lazy">
                      {%- else -%}
                        {{ r.initials | default: r.name | slice: 0, 2 | upcase }}
                      {%- endif -%}
                    </div>
                    <div class="ks__reviewer-info">
                      <p class="ks__reviewer-name">{{ r.name }}</p>
                      {%- if r.verified -%}
                        <span class="ks__verified">
                          <span>{{ r.verified_label | default: 'Verified Buyer' }}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
  <path d="M8 16C6.89583 16 5.85938 15.7917 4.89062 15.375C3.91146 14.9583 3.0599 14.388 2.33594 13.6641C1.61198 12.9401 1.04167 12.0885 0.625 11.1094C0.208333 10.1406 0 9.10417 0 8C0 6.89583 0.208333 5.85938 0.625 4.89062C1.04167 3.91146 1.61198 3.0599 2.33594 2.33594C3.0599 1.61198 3.91146 1.04167 4.89062 0.625C5.85938 0.208333 6.89583 0 8 0C9.10417 0 10.1406 0.208333 11.1094 0.625C12.0885 1.04167 12.9401 1.61198 13.6641 2.33594C14.388 3.0599 14.9583 3.91146 15.375 4.89062C15.7917 5.85938 16 6.89583 16 8C16 9.10417 15.7917 10.1406 15.375 11.1094C14.9583 12.0885 14.388 12.9401 13.6641 13.6641C12.9401 14.388 12.0885 14.9583 11.1094 15.375C10.1406 15.7917 9.10417 16 8 16ZM11.4531 4.42188L6.71875 9.14062L4.46875 6.90625L3 8.375L6.71875 12.0781L12.9219 5.89062L11.4531 4.42188Z" fill="#F45901"/>
</svg>
                        </span>
                      {%- endif -%}
                    </div>
                  </div>

                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>

        {%- if reviews.size > 1 -%}
          <div class="ks__controls" role="group" aria-label="Review carousel controls">
            <button
              type="button"
              class="ks__nav ks__nav--prev"
              data-prev
              aria-label="Previous review"
              aria-controls="{{ sec_id }}-track">
           <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
  <path d="M10.625 3.1875L5.3125 8.5L10.625 13.8125" stroke="#341300" stroke-width="1.41871" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
            </button>

            <button
              type="button"
              class="ks__nav ks__nav--next is-active"
              data-next
              aria-label="Next review"
              aria-controls="{{ sec_id }}-track">

<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
<path d="M6.75 3.375L12.375 9L6.75 14.625" stroke="white" stroke-width="1.41871" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
            </button>
          </div>

          <span data-live class="ks__sr-only" aria-live="polite" aria-atomic="true"></span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</section>

{%- comment -%} =====================================================
                CAROUSEL JAVASCRIPT
                ===================================================== {%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('{{ sec_id }}');
    if (!root) return;

    var slider = root.querySelector('[data-slider]');
    if (!slider) return;

    var track   = slider.querySelector('[data-track]');
    var prevBtn = slider.querySelector('[data-prev]');
    var nextBtn = slider.querySelector('[data-next]');
    var live    = slider.querySelector('[data-live]');
    var slides  = track ? track.querySelectorAll('[data-slide]') : [];
    var total   = slides.length;
    if (!track || total < 2) return;

    var current = 0;

    /* Scroll to a given index using the slide's offsetLeft inside the track.
       Using scrollTo with behavior:'smooth' lets CSS scroll-snap handle the
       final alignment naturally — no manual position math required. */
    function goTo(index, opts) {
      opts = opts || {};
      if (index < 0) index = 0;
      if (index > total - 1) index = total - 1;

      var target = slides[index];
      if (!target) return;

      track.scrollTo({
        left: target.offsetLeft - track.offsetLeft,
        behavior: opts.instant ? 'auto' : 'smooth'
      });

      current = index;
      updateState();
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    /* Update button states + announce the new slide to screen readers */
    function updateState() {
      if (prevBtn) {
        prevBtn.disabled = (current === 0);
        prevBtn.classList.toggle('is-active', current > 0);
      }
      if (nextBtn) {
        nextBtn.disabled = (current === total - 1);
        nextBtn.classList.toggle('is-active', current < total - 1);
      }
      if (live) {
        live.textContent = 'Showing review ' + (current + 1) + ' of ' + total;
      }
    }

    /* Detect which slide is most visible after a manual swipe / scroll
       (touch users dragging the track directly).
       We pick the slide whose left edge is closest to the track's scroll position. */
    var scrollSyncTimer;
    function onTrackScroll() {
      clearTimeout(scrollSyncTimer);
      scrollSyncTimer = setTimeout(function () {
        var pos = track.scrollLeft;
        var best = 0;
        var bestDist = Infinity;
        for (var i = 0; i < total; i++) {
          var d = Math.abs(slides[i].offsetLeft - track.offsetLeft - pos);
          if (d < bestDist) { bestDist = d; best = i; }
        }
        if (best !== current) {
          current = best;
          updateState();
        }
      }, 90);
    }

    /* Keyboard navigation — when the track is focused */
    function onKeydown(e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
      else if (e.key === 'End') { e.preventDefault(); goTo(total - 1); }
    }

    if (prevBtn) prevBtn.addEventListener('click', prev);
    if (nextBtn) nextBtn.addEventListener('click', next);
    track.addEventListener('scroll', onTrackScroll, { passive: true });
    track.addEventListener('keydown', onKeydown);

    /* Recalculate on resize — slide widths follow viewport */
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        goTo(current, { instant: true });
      }, 100);
    });

    /* Initialize */
    updateState();
  })();
</script>

