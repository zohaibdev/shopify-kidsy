</style>
 <section class="product-condition-section" style="background-color: {{ section.settings.section_bg_color }};">
        <div class="container">
            <div class="header-wrap">
                <h2>{{ section.settings.heading }}</h2>
            </div>
           <div class="accordion-intro-mobile">
                        <p> {{ section.settings.intro-text }}</p>
                    </div>
            <div class="accordion-layout">
                <div class="accodian-grid">
                    <div class="accordion-intro">
                        <p> {{ section.settings.intro-text }}</p>
                    </div>
                    <div class="accordion-items">
                        {% for block in section.blocks %}
                        <div class="accordion-item">
                          <div class="item_wrapper">
                            <div class="accordion-title">
                                <h3> {{ block.settings.heading }}</h3>
                           
                            <div class="accordion-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="31" height="31" viewBox="0 0 31 31"
                                    fill="none">
                                    <circle cx="15.5" cy="15.5" r="15.2281" transform="rotate(90 15.5 15.5)"
                                        fill="white" stroke="black" stroke-width="0.54386" />
                                    <path
                                        d="M20.4893 13.6572C20.5255 13.6184 20.5691 13.5872 20.6176 13.5656C20.666 13.544 20.7184 13.5324 20.7714 13.5315C20.8245 13.5305 20.8772 13.5403 20.9264 13.5602C20.9756 13.58 21.0203 13.6096 21.0578 13.6471C21.0953 13.6847 21.1249 13.7294 21.1448 13.7786C21.1646 13.8278 21.1744 13.8805 21.1735 13.9335C21.1725 13.9866 21.1609 14.0389 21.1393 14.0874C21.1177 14.1359 21.0866 14.1795 21.0478 14.2157L15.7791 19.4843C15.705 19.5583 15.6046 19.5999 15.4999 19.5999C15.3952 19.5999 15.2947 19.5583 15.2206 19.4843L9.952 14.2157C9.8822 14.1407 9.8442 14.0417 9.84601 13.9393C9.84782 13.8369 9.88929 13.7393 9.96168 13.6669C10.0341 13.5945 10.1318 13.553 10.2341 13.5512C10.3365 13.5494 10.4356 13.5874 10.5105 13.6572L15.4999 18.6459L20.4893 13.6572Z"
                                        fill="black" />
                                </svg>
                            </div>
                                        </div>
                          </div>
                            <div class="accordion-content">
                                <div> {{ block.settings.text }} </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="accordion-image-block">
                    <div class="image-description">
                        <div> {{ section.settings.img_content }} </div>
                    </div>
                    <div class="image-wrapper">
                        <img src="{{ section.settings.chair_img | image_url }}" alt="{{ section.settings.heading }}"
                            width="{{ section.settings.chair_img.width }}"
                            height="{{ section.settings.chair_img.height }}" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const accordionHeaders = document.querySelectorAll(".item_wrapper");
    const accordionItems = document.querySelectorAll('.accordion-item');

    // Open the first item by default
    if (accordionItems.length > 0) {
      accordionItems[0].classList.add('open');
    }

    if (accordionHeaders) {
      accordionHeaders.forEach(header => {
        header.addEventListener("click", function () {
          const subTextBox = this.closest('.accordion-item');
          // Close all other open boxes
          document.querySelectorAll('.accordion-item.open').forEach(box => {
            if (box !== subTextBox) {
              box.classList.remove('open');
            }
          });
          // Toggle current box
          subTextBox.classList.toggle('open');
        });
      });
    }
  });
</script>

                                      
{% schema %}
  {
    "name": "Product Condition",
     "settings": [
         {
          "type": "header",
          "content": "Styling"
        },
        {
          "type": "color",
          "id": "section_bg_color",
          "label": "Background Color",
          "default":"#fff"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Add Heading"
        },
        {
          "type": "text",
          "id": "intro-text",
          "label": "Add Text"
        },
      {
          "type": "image_picker",
          "id":"chair_img",
          "label": "Select Chair Image"
      },
       {
          "type": "richtext",
          "id": "img_content",
          "label": "Add Content"
        },
     ],
    "blocks": [
     {
       "type": "content",
       "name":"Content",
       "settings": [
    {
        "type": "text",
        "id":"heading",
        "label": "Select Heading"
    },
    {
        "type": "richtext",
        "id": "text",
        "label": "Add Content"
    },
   ]
     }
  ],
"presets": [
      {
        "name": "Product Condition"
      }
    ]
  }
{% endschema %}