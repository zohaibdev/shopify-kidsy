<section class="kidsy_banner_section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="kidsy_banner_wrapper">
      {% for block in section.blocks %}
        <div
          class="banner-content"
          style="background-color:{{ section.settings.bg_color }};color:{{ section.settings.txt_color }}"
        >
          <div class="text-block">
            <div class="rating">
              <div class="rating-svg">
               
                {% assign rating = block.settings.star_rating %}

                <div class="star-rating">
                  {% for i in (1..5) %}
                    {% if i <= rating %}
                      <!-- Filled star -->
                      <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24.8696 0H0V24.8696H24.8696V0Z" fill="#00B67A"/>
                        <path d="M12.1749 16.5797L16.0608 15.5435L17.6151 20.4656L12.1749 16.5797ZM20.9829 10.3623H14.2473L12.1749 4.14493L10.1024 10.3623H3.62598L9.06619 14.2482L6.99373 20.4656L12.4339 16.5797L15.8017 14.2482L20.9829 10.3623Z" fill="white"/>
                      </svg>

                    {% else %}
                      <!-- Unfilled star -->
                      <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24.8696 0H0V24.8696H24.8696V0Z" fill="#E0E0E0"/>
                        <path d="M12.1749 16.5797L16.0608 15.5435L17.6151 20.4656L12.1749 16.5797ZM20.9829 10.3623H14.2473L12.1749 4.14493L10.1024 10.3623H3.62598L9.06619 14.2482L6.99373 20.4656L12.4339 16.5797L15.8017 14.2482L20.9829 10.3623Z" fill="white"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              <div class="svg_text">
                {{ block.settings.ratign_text }}
              </div>
            </div>
            {% if block.settings.heading != blank %}
              <div class="heading">{{ block.settings.heading }}</div>
            {% endif %}
            {% if block.settings.enable_speciality %}
              <div class="speciality-wrap">
                {% for index in (1..3) %}
                  {% liquid
                    assign icon = 'icon_' | append: index
                    assign text = 'text_' | append: index
                  %}
                  {% if block.settings[icon] != blank and block.settings[text] != blank %}
                    <div class="speciality-box">
                      <span class="icon"
                        ><img
                          src="{{  block.settings[icon] | image_url : width: 80 }}"
                          alt="block.settings[text]"
                          loading="lazy"
                          width="{{ block.settings[icon].width }}"
                          height="{{ block.settings[icon].height }}"
                        >
                      </span>
                      <div class="text">
                        {{ block.settings.txt_color }}
                        {{ block.settings[text] }}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            <a class="btn-main {{ block.settings.btn_style }}" href="{{ block.settings.btn_link }}">
              {{ block.settings.btn_txt }}
            </a>
            <div class="banner-logos">
              {% if block.settings.logo_1 %}
              <img
                src="{{ block.settings.logo_1 | image_url: width: 150  }}"
                alt="{{ shop.name }}"
                loading="lazy"
                width="{{ block.settings.logo_1.width }}"
                height="{{ block.settings.logo_1.height }}"
              >
              {% endif %}
              {% if block.settings.logo_2 %}
              <img
                src="{{ block.settings.logo_2 | image_url: width: 150  }}"
                alt="{{ shop.name }}"
                loading="lazy"
                width="{{ block.settings.logo_2.width }}"
                height="{{ block.settings.logo_2.height }}"
              >
              {% endif %}
             {% if block.settings.logo_3 %}
              <img
                src="{{ block.settings.logo_3 | image_url: width: 150  }}"
                alt="{{ shop.name }}"
                loading="lazy"
                width="{{ block.settings.logo_3.width }}"
                height="{{ block.settings.logo_3.height }}"
              >
             {% endif %}
            </div>
          </div>
          <div class="product_img">
            {% for block in section.blocks %}
              {% if block.settings.image_link != blank %}
              <a
                  href="{{ block.settings.image_link }}" 
                  title="{{ block.settings.image_alt | escape }}" 
                  aria-label="{{ block.settings.image_alt | escape }}"
                >
              {% endif %}
                <div class="toy_img">
                  {%- if block.settings.image != blank -%}
                    {%- liquid
                      assign mobileImage = block.settings.image
                      if block.settings.image_mobile != blank
                        assign mobileImage = block.settings.image_mobile
                      endif
                    -%}
                    <picture>
                      <source media="(min-width: 1901px)" srcset="{{ block.settings.image | image_url: width: 2560 }}">
                      <source media="(min-width: 1700px)" srcset="{{ block.settings.image | image_url: width: 2020 }}">
                      <source media="(min-width: 1500px)" srcset="{{ block.settings.image | image_url: width: 1820 }}">
                      <source media="(min-width: 1200px)" srcset="{{ block.settings.image | image_url: width: 1600 }}">
                      <source media="(min-width: 991px)" srcset="{{ block.settings.image | image_url: width: 1350 }}">
                      <source media="(min-width: 768px)" srcset="{{ mobileImage | image_url: width: 1100 }}">
                      <source media="(min-width: 576px)" srcset="{{ mobileImage | image_url: width: 800 }}">
                      <source media="(min-width: 400px)" srcset="{{ mobileImage | image_url: width: 700 }}">
                      <source media="(min-width: 0)" srcset="{{ mobileImage | image_url: width: 600 }}">
                      <source media="(min-width: 0)" srcset="{{ mobileImage | image_url: width: 400 }}">
                      <img
                        src="{{ block.settings.image | image_url }}"
                        alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                        width="{{ block.settings.image.width }}"
                        loading="lazy"
                        fetchpriority="high"
                        height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round }}"
                      >
                    </picture>
                  {%- endif -%}
                </div>
              {% if block.settings.image_link != blank %}
              </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
    "name": "kidsy Banner",
    "settings": [
                    {
                    "type": "color",
                    "id":"bg_color",
                    "label":"Select Background Color",
                    "default":"#fff"
                  },
    ],
    "blocks": [
       {
          "type": "slide",
          "name": "slide",
          "settings": [

             {
                "type": "range",
                "id": "star_rating",
                "label": "Star Rating",
                "min": 0,
                "max": 5,
                "step": 1,
                "default": 5
              },
              {
                  "type": "inline_richtext",
                  "id": "ratign_text",
                  "label": "Rating Text",
              },
              {
                  "type": "richtext",
                  "id": "heading",
                  "label": "Heading"
              },
               {
                "type": "checkbox",
                "id": "enable_speciality",
                "label": "Enable Speciality",
                "default": true
              },
              {
                "type": "image_picker",
                "id": "icon_1",
                "label": "Icon 1"
              },
              {
                  "type": "richtext",
                  "id": "text_1",
                  "label": "Text 1"
              },
              {
                "type": "image_picker",
                "id": "icon_2",
                "label": "Icon 2"
              },
              {
                  "type": "richtext",
                  "id": "text_2",
                  "label": "Text 2"
              },
              {
                "type": "image_picker",
                "id": "icon_3",
                "label": "Icon 3"
              },
              {
                  "type": "richtext",
                  "id": "text_3",
                  "label": "Text 3"
              },
                                  {
                  "type": "text",
                  "id": "btn_txt",
                  "label": "Button Text"
                  },
                  {
                  "type": "url",
                  "id": "btn_link",
                  "label": "Button Link"
                  },
                                     {
                "type": "image_picker",
                "id": "logo_1",
                "label": "Logo 1"
              },
             {
                "type": "image_picker",
                "id": "logo_2",
                "label": "Logo 2"
              },
             {
                "type": "image_picker",
                "id": "logo_3",
                "label": "Logo 3"
              },

               {
                "type": "image_picker",
                "id": "image",
                "label": "Dekstop Image"
              },
              {
                "type": "image_picker",
                "id": "image_mobile",
                "label": "Mobile Image"
              },
              {
               "type": "url",
               "id":"image_link",
               "label":"Add Image Link"
              }

            ]
        }
    ],

    "presets": [
        {
            "name": "kidsy Banner"
        },
    ],
}
{% endschema %}
