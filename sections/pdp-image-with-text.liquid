{% schema %}
{
  "name": "pdp image with text",
  "settings": [
       {
        "type": "color",
        "id":"bg_color",
        "label":"Select Background Color",
      },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Add Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Main Heading",
    },
    {
      "type": "richtext",
      "id": "sub_text",
      "label": "Add text",
    },
       {
       "type": "richtext",
       "id": "text1",
       "label": "Add text"
     },
       {
       "type": "richtext",
       "id": "text2",
       "label": "Add text"
     },
       {
       "type": "richtext",
       "id": "text3",
       "label": "Add text"
     },
        {
      "type": "text",
      "id": "btn_txt",
      "label": "Button Text"
      },
      {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
      },   
  ],

  "presets": [
    {
      "name": "pdp image with text"
    }
  ]
}
{% endschema %}