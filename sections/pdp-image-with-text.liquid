<section class="pdp_image_with_text"style="background-color:{{ section.settings.bg_color }};color:{{ section.settings.txt_color }}">
<div class="page-width">
  <div class="check_it_wrapper">
        <div class="producy_image">
     {%- if section.settings.bg_image != blank -%}
            {%- liquid
              assign mobileImage = section.settings.bg_image
              if section.settings.bg_image_mobile != blank
                assign mobileImage = section.settings.bg_image_mobile
              endif
            -%}
            <picture>
              <source media="(min-width: 1901px)" srcset="{{ section.settings.bg_image | image_url: width: 2560 }}">
              <source media="(min-width: 1700px)" srcset="{{ section.settings.bg_image | image_url: width: 2020 }}">
              <source media="(min-width: 1500px)" srcset="{{ section.settings.bg_image | image_url: width: 1820 }}">
              <source media="(min-width: 1200px)" srcset="{{ section.settings.bg_image | image_url: width: 1600 }}">
              <source media="(min-width: 991px)" srcset="{{ section.settings.bg_image | image_url: width: 1350 }}">
              <source media="(min-width: 768px)" srcset="{{ mobileImage | image_url: width: 1100 }}">
              <source media="(min-width: 576px)" srcset="{{ mobileImage | image_url: width: 800 }}">
              <source media="(min-width: 400px)" srcset="{{ mobileImage | image_url: width: 700 }}">
              <source media="(min-width: 0)" srcset="{{ mobileImage | image_url: width: 600 }}">
              <img src="{{ section.settings.bg_image | image_url }}"
                   alt="{{ section.settings.bg_image.alt | default: section.settings.testimonial_heading | escape }}"
                   width="{{ section.settings.bg_image.width }}"
                   height="{{ section.settings.bg_image.width | divided_by: section.settings.bg_image.aspect_ratio | round }}"
                   loading="lazy">
            </picture>
          {%- endif -%}
    </div>
    <div class="check_content">
      <div class="heading_wrapper">
     <div class="heading">{{ section.settings.heading }}</div>
