{% style %}
  #shopify-section-{{ section.id }} .premium-gear-section { padding-top: {{ section.settings.padding_top_mobile | default: 20 }}px; padding-bottom: {{ section.settings.padding_bottom_mobile | default: 20 }}px; } @media screen and (min-width: 769px) { #shopify-section-{{ section.id }} .premium-gear-section { padding-top: {{ section.settings.padding_top | default: 30 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 30 }}px; } } #shopify-section-{{ section.id }} .premium-gear-section .image-contain-wrapper { {%- if section.settings.inner_container_bg_color != blank -%} background-color: {{ section.settings.inner_container_bg_color }}; {%- endif -%} {%- if section.settings.inner_container_text_color != blank -%} color: {{ section.settings.inner_container_text_color }}; {%- endif -%} } #shopify-section-{{ section.id }} .premium-gear-section .image-contain-wrap { text-align: {{ section.settings.content_text_align | default: 'center' }}; } #shopify-section-{{ section.id }} .premium-gear-section .image-contain-wrap .sub-heading-text-wrapper { text-align: {{ section.settings.content_text_align | default: 'center' }}; color: rgb(var(--color-foreground)); } @media only screen and (max-width: 768px) { #shopify-section-{{ section.id }} .premium-gear-section .sub-heanding-wrap h5 { padding-bottom: 4px; text-align: {{ section.settings.content_text_align | default: 'center' }}; } #shopify-section-{{ section.id }} .premium-gear-section .text-wrap p { text-align: {{ section.settings.content_text_align | default: 'center' }}; } }
{% endstyle %}
<section class="premium-gear-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="premium-gear-wrapper">
      
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper {% if section.settings.cta_label != blank %}header-with-CTA{% endif %}">
          <div class="section-header-content">
            {% if section.settings.heading_link != blank %}
              <a href="{{ section.settings.heading_link }}" class="section--title h3" title="{{ section.settings.title | escape }}">
                {{ section.settings.title | escape }}
              </a>
            {% else %}
              <h3 class="section--title h3">
                {{ section.settings.title | escape }}
              </h3>
            {% endif %}
            {% if section.settings.subtitle != blank %}
              <p class="section-description">
                {{ section.settings.subtitle }}
              </p>
            {% endif %}
          </div>
          {% if section.settings.cta_label != blank %}
            <div class="section-header-cta">
              <a class="button button--{{ section.settings.cta_button_style }} title__button" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>
                {{ section.settings.cta_label | escape }}
              </a>
            </div>
          {% endif %}
        </div>
      {%- endunless -%}

      <div class="image-contain-wrapper color-{{ section.settings.color_scheme_2 }} gradient">
        <div class="image-contain-slider swiper-class swiper">
          <div class="image-contain-slider-wrapper swiper-wrapper">
            {% for block in section.blocks %}
              <div class="image-contain-slide swiper-slide" {{ block.shopify_attributes }}>
                <a {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %} class="image-contain-wrap color-{{ block.settings.card_color_scheme | default: section.settings.color_scheme_2 }} gradient">
                  <div class="image-wrap">
                    {% render 'custom-image', image: block.settings.icon_image, alt: block.settings.icon_image.alt %}
                  </div>
                  <div class="sub-heading-text-wrapper">
                    <span class="step-badge"> {{ block.settings.step }} </span>
                    <div class="sub-heanding-wrap">
                      <h6 class="h6">{{ block.settings.sub_heading }}</h6>
                    </div>
                    <div class="text-wrap">{{ block.settings.sub_text }}</div>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="premium-gear-slider-nav swiper-navigation">
        <div class="swiper-pagination"></div>
      </div>

      <div class="premium-gear-mobile-cta-wrapper">
         {% if section.settings.cta_label != blank %}
            <div class="section-header-cta">
              <a class="button button--{{ section.settings.cta_button_style }} title__button" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>
                {{ section.settings.cta_label | escape }}
              </a>
            </div>
          {% endif %}
      </div>
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const sliderEl = document.querySelector('#shopify-section-{{ section.id }} .image-contain-slider');
  if (sliderEl) {
    const totalSlides = sliderEl.querySelectorAll('.image-contain-slide').length;
    const enableAutoplay = totalSlides > 4;
    new Swiper(sliderEl, {
      loop: enableAutoplay,
      slidesPerView: Number('{{ section.settings.slider_mobile_slides_per_view | default: '1.5' }}'),
      spaceBetween: 20,
      slidesPerGroup: 1,
      autoplay: enableAutoplay ? {
        delay: 2500,
        disableOnInteraction: false
      } : false,
      pagination: {
        el: '#shopify-section-{{ section.id }} .swiper-pagination',
        clickable: true
      },
      breakpoints: {
        750: {
          slidesPerView: {{ section.settings.slider_slides_per_view | minus: 1.3 }},
          spaceBetween: 20,
          slidesPerGroup: 1,
          allowTouchMove: true
        },
        1024: {
          slidesPerView: {{ section.settings.slider_slides_per_view | default: 4 }},
          allowTouchMove: false,
          spaceBetween: {{ section.settings.slider_space_between | default: 12 }},
        }
      }
    });
  }
});
</script>
{% schema %}
{
  "name": "baby gear Section",
  "class": "baby-gear--section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Sets the background and text colors for the entire section"
    },
     {
      "type": "color_scheme",
      "id": "color_scheme_2",
      "label": "Color scheme For Container",
      "default": "scheme-2"
    },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Best sellers on kidsy"
      },
      {
        "type": "url",
        "id": "heading_link",
        "label": "Heading link URL"
      },
      {
        "type": "inline_richtext",
        "id": "subtitle",
        "label": "Subtitle"
      },
      {
        "type": "text",
        "id": "cta_label",
        "label": "Button text",
        "default": "View All"
      },
      {
        "type": "url",
        "id": "cta_link",
        "label": "Button Link"
      },
      {
        "id": "cta_button_style",
        "type": "select",
        "label": "Button Style",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "secondary",
            "label": "Secondary"
          }
        ],
        "default": "primary"
      },
    {
      "type": "header",
      "content": "Inner Container Settings"
    },
    {
      "type": "select",
      "id": "content_text_align",
      "label": "Content text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": "Text alignment for all content blocks"
    },
    {
        "type": "header",
        "content": "Section Padding - Desktop"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "header",
        "content": "Section Padding - Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding Top (px)",
        "min": 0,
        "max": 80,
        "step": 5,
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding Bottom (px)",
        "min": 0,
        "max": 80,
        "step": 5,
        "default": 40
      },
      {
        "type": "header",
        "content": "Slider Settings"
      },
      {
        "type": "number",
        "id": "slider_slides_per_view",
        "label": "Slides per view (desktop)",
        "default": 3
      },
      {
        "type": "range",
        "id": "slider_mobile_slides_per_view",
        "label": "Slides per view (mobile)",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "default": 1.2
      },
      {
        "type": "number",
        "id": "slider_space_between",
        "label": "Slide space (px)",
        "default": 12
      }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "step",
          "label": "Steps"
        },
        {
          "type": "text",
          "id": "sub_heading",
          "label": "Sub Heading"
        },

        {
          "type": "richtext",
          "id": "sub_text",
          "label": "Paragraph"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "baby gear Section"
    }
  ]
}
{% endschema %}