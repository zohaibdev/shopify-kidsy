<style>
  #shopify-section-{{ section.id }} .collection-banner { position: relative; overflow: hidden; padding: 32px 24px; } #shopify-section-{{ section.id }} .collection-banner__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: center; } #shopify-section-{{ section.id }} .collection-banner__content { max-width: 640px; } #shopify-section-{{ section.id }} .collection-banner__title { margin: 0 0 20px; } #shopify-section-{{ section.id }} .collection-banner__feature-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 24px; list-style: none; padding: 0; margin: 0; } #shopify-section-{{ section.id }} .collection-banner__feature { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; padding:10px; } #shopify-section-{{ section.id }} .collection-banner__feature-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; } .collection-banner__feature-icon img { width: 100%; height: 100%; object-fit: contain; } .collection-banner__feature-title { margin: 0; text-transform:uppercase; } .collection-banner__feature-text p{ margin:0px!important; } #shopify-section-{{ section.id }} .collection-banner__image-wrap { justify-self: center; } #shopify-section-{{ section.id }} .collection-banner__image-circle { position: relative; width: min(280px, 70vw); aspect-ratio: 1 / 1; border-radius: 50%; border: 1px solid rgba(var(--theme_color-body_rgb),0.19);; background: var(--theme_color-white); display: flex; align-items: center; justify-content: center; overflow: hidden; } #shopify-section-{{ section.id }} .collection-banner__image-circle img { width: 100%; height: 100%; object-fit: contain; } @media screen and (min-width: 990px) { #shopify-section-{{ section.id }} .collection-banner { padding-top: {{ section.settings.padding_top | default: 60 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px; } #shopify-section-{{ section.id }} .collection-banner__inner { grid-template-columns: 1fr minmax(280px, 360px); gap: 48px; } #shopify-section-{{ section.id }} .collection-banner__feature-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } } @media screen and (max-width: 989px) { #shopify-section-{{ section.id }} .collection-banner__feature-list { grid-template-columns: minmax(0, 1fr); } } {% if section.settings.hide_on_mobile %} @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} { display: none; } } {% endif %}
</style>

{%- assign banner_image = section.settings.override_image -%}
{%- if banner_image == blank and collection and collection.image != blank -%}
  {%- assign banner_image = collection.image -%}
{%- endif -%}
{%- assign banner_image_alt = section.settings.title -%}
{%- if banner_image != blank and banner_image.alt != blank -%}
  {%- assign banner_image_alt = banner_image.alt -%}
{%- endif -%}

<section class="collection-banner color-{{ section.settings.color_scheme }} gradient" data-section-id="{{ section.id }}">
  <div class="collection-banner__inner page-width">
    <div class="collection-banner__content">

      {% if section.settings.title != blank %}
        <h2 class="collection-banner__title h1">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="collection-banner__feature-list">
          {% for block in section.blocks %}
            <li class="collection-banner__feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="collection-banner__feature-icon">
                  {% assign feature_icon_alt = block.settings.title | default: 'Feature icon' %}
                  {{ block.settings.icon | image_url: width: 64 | image_tag: alt: feature_icon_alt, class: 'collection-banner__feature-icon-image' }}
                </span>
              {% endif %}
              <div>
                {% if block.settings.title != blank %}
                  <h3 class="collection-banner__feature-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="collection-banner__feature-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% if banner_image != blank %}
      <div class="collection-banner__image-wrap">
        <div class="collection-banner__image-circle">
          {{ banner_image | image_url: width: 600 | image_tag: widths: '320,480,600', alt: banner_image_alt, loading: 'lazy', class: 'collection-banner__image' }}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "override_image",
      "label": "Override collection image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Smart Gear For Every Stage"
    },
    {
        "type": "header",
        "content": "Section Padding - Desktop"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Premium Savings"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Supporting text",
          "default": "Save up to 70% off retail."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection banner",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}{% endstylesheet %}
{% javascript %}{% endjavascript %}

