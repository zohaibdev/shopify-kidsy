{% comment %}
SECTION: Home Hero (home-hero)
ROLE: Full-width hero banner with carousel/slider functionality. Each slide displays an image background with overlaid content including eyebrow text (social proof) in H1, main headline, paragraph text, and a call-to-action button. Includes navigation arrows and dot indicators.
NOTES: Uses theme's slider-component and slideshow styles. Images are editable per slide. Content is positioned on the left side of each slide for optimal readability.
{% endcomment %}

{% comment %}{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}{% endcomment %}
<link rel="preload" href="{{ 'section-image-banner.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'section-image-banner.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'section-image-banner.css' | asset_url }}"></noscript>
{% comment %}{{ 'component-slider.css' | asset_url | stylesheet_tag }}{% endcomment %}
<link rel="preload" href="{{ 'component-slider.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}"></noscript>
{% comment %}{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}{% endcomment %}
<link rel="preload" href="{{ 'component-slideshow.css' | asset_url }}" as="style">
<link rel="stylesheet" href="{{ 'component-slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'component-slideshow.css' | asset_url }}"></noscript>

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) { #HomeHero-{{ section.id }}::before, #HomeHero-{{ section.id }} .hero-slide__media::before, #HomeHero-{{ section.id }} .hero-slide__content::before { padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%; content: ''; display: block; } } @media screen and (min-width: 750px) { #HomeHero-{{ section.id }}::before, #HomeHero-{{ section.id }} .hero-slide__media::before { padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%; content: ''; display: block; } }
  {%- endstyle -%}
{%- endif -%}

<div class="home-hero section-{{ section.id }} {{ section.settings.bg_variant }}" data-section-type="home-hero">
  {%- comment -%} First child: Section container {%- endcomment -%}

  <slideshow-component
    class="home-hero__slider"
    role="region"
    aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
    aria-label="{{ section.settings.accessibility_info | escape }}"
  >
    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="slider-button slider-button--prev home-hero__arrow home-hero__arrow--left"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="HomeHero-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <button
        type="button"
        class="slider-button slider-button--next home-hero__arrow home-hero__arrow--right"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="HomeHero-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    {%- endif -%}
    <div class="home-hero__card-wrapper">
      {%- if section.blocks.size > 1 -%}
        <div class="home-hero__dots">
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--dots link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="HomeHero-{{ section.id }}"
              >
                <span class="dot"></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div
        class="home-hero__slides slider slider--everywhere{% if section.blocks.first.settings.image == blank %} home-hero--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
        id="HomeHero-{{ section.id }}"
        aria-live="polite"
        aria-atomic="true"
        data-autoplay="{{ section.settings.auto_rotate }}"
        data-speed="{{ section.settings.change_slides_speed }}"
      >
      {%- for block in section.blocks -%}
        <div
          class="home-hero__slide slider__slide"
          id="HomeHeroSlide-{{ section.id }}-{{ forloop.index }}"
          {{ block.shopify_attributes }}
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          tabindex="-1"
        >
          <div class="hero-slide__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {%- if block.settings.image -%}
              {%- liquid
                assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                if section.settings.image_behavior == 'ambient'
                  assign sizes = '120vw'
                  assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
                else
                  assign sizes = '100vw'
                  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                endif
                assign fetch_priority = 'auto'
                if section.index == 1 and forloop.first
                  assign fetch_priority = 'high'
                endif
              -%}
              {%- if forloop.first %}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                }}
              {%- endif -%}
            {%- else -%}
              {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
              {%- if placeholder_slide == 1 -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}
          </div>
          <div class="hero-slide__content">
            {%- assign use_theme_container = section.settings.use_theme_container -%}
            {%- if use_theme_container -%}
              <div class="{{ section.settings.theme_container_class }}">
                <div class="hero-slide__text-wrapper">
                  <div class="hero-slide__text color-{{ block.settings.color_scheme }} gradient">
                    {%- if block.settings.eyebrow_text != blank -%}
                      {%- assign eyebrow_tag = block.settings.eyebrow_heading_tag | default: 'h1' -%}
                      <{{ eyebrow_tag }} class="hero-slide__eyebrow eyebrow">
                        {{ block.settings.eyebrow_text | escape }}
                      </{{ eyebrow_tag }}>
                    {%- endif -%}

                    {%- if block.settings.heading != blank -%}
                      {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
                      <{{ heading_tag }} class="hero-slide__heading {{ block.settings.heading_size }}">
                        {{ block.settings.heading }}
                      </{{ heading_tag }}>
                    {%- endif -%}

                    {%- if block.settings.paragraph_text != blank -%}
                      <div class="hero-slide__paragraph rte">
                        {{ block.settings.paragraph_text }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                      <div class="hero-slide__actions">
                        <a class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}" href="{{ block.settings.button_url }}">
                          {{ block.settings.button_label | escape }}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <div class="global-container">
                <div class="hero-slide__text-wrapper">
                  <div class="hero-slide__text color-{{ block.settings.color_scheme }} gradient">
                    {%- if block.settings.eyebrow_text != blank -%}
                      {%- assign eyebrow_tag = block.settings.eyebrow_heading_tag | default: 'h1' -%}
                      <{{ eyebrow_tag }} class="hero-slide__eyebrow eyebrow">
                        {{ block.settings.eyebrow_text | escape }}
                      </{{ eyebrow_tag }}>
                    {%- endif -%}

                    {%- if block.settings.heading != blank -%}
                      {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
                      <{{ heading_tag }} class="hero-slide__heading {{ block.settings.heading_size }}">
                        {{ block.settings.heading }}
                      </{{ heading_tag }}>
                    {%- endif -%}

                    {%- if block.settings.paragraph_text != blank -%}
                      <div class="hero-slide__paragraph rte">
                        {{ block.settings.paragraph_text }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                      <div class="hero-slide__actions">
                        <a class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}" href="{{ block.settings.button_url }}">
                          {{ block.settings.button_label | escape }}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      </div>
    </div>
  </slideshow-component>
</div>

