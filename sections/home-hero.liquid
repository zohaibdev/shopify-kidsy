=== CSS (scoped) ===
{%- endcomment -%}
{% style %}
.section-{{ section.id }} { background: #FFFBF3; position: relative; padding: {{ section.settings.card_padding }}px; } .section-{{ section.id }} .home-hero__slider { position: relative; max-width: {{ section.settings.max_width }}px; margin: 0 auto; } .section-{{ section.id }} .home-hero__card-wrapper { position: relative; background: #FFFBF3; border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }}; border-radius: {{ section.settings.card_border_radius }}px; overflow: hidden; } .section-{{ section.id }} .home-hero__slides { position: relative; overflow: hidden; height: {{ section.settings.slide_min_height }}px; } .section-{{ section.id }} .home-hero__slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.6s ease-in-out; visibility: hidden; } .section-{{ section.id }} .home-hero__slide.is-active { opacity: 1; visibility: visible; position: relative; } .section-{{ section.id }} .hero-slide__media { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; } .section-{{ section.id }} .hero-slide__media img { width: 100%; height: 100%; object-fit: cover; } .section-{{ section.id }} .hero-slide__media::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity | divided_by: 100.0 }}); z-index: 1; } .section-{{ section.id }} .hero-slide__content { position: relative; z-index: 2; height: 100%; display: flex; align-items: center; } .section-{{ section.id }} .hero-slide__text-wrapper { width: 100%; max-width: {{ section.settings.content_max_width }}px; padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_sides }}px {{ section.settings.content_padding_bottom }}px; } .section-{{ section.id }} .hero-slide__text { padding: 2rem; border-radius: {{ section.settings.text_border_radius }}px; text-align: left; display: flex; flex-direction: column; align-items: flex-start; background: transparent; } .section-{{ section.id }} .hero-slide__eyebrow { font-size: {{ section.settings.eyebrow_font_size }}px; margin-bottom: 1rem; opacity: 0.9; letter-spacing: 0.02em; font-weight: 600; text-align: left; color: #ffffff; } .section-{{ section.id }} .hero-slide__heading { margin-bottom: 1.5rem; line-height: 1.2; text-align: left; color: #ffffff; } .section-{{ section.id }} .hero-slide__paragraph { margin-bottom: 2rem; max-width: {{ section.settings.paragraph_max_width }}px; font-size: {{ section.settings.paragraph_font_size }}px; line-height: 1.6; text-align: left; color: #ffffff; } .section-{{ section.id }} .hero-slide__actions { margin-top: 1.5rem; } .section-{{ section.id }} .hero-slide__actions .button--primary { background-color: #F45901; border-color: #F45901; color: #ffffff; } .section-{{ section.id }} .hero-slide__actions .button--primary:hover { background-color: #d14a01; border-color: #d14a01; color: #ffffff; } .section-{{ section.id }} .home-hero__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 100; width: 44px; height: 44px; border-radius: 50%; background: {{ section.settings.button_color }}; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: opacity 0.3s ease; } .section-{{ section.id }} .home-hero__arrow:hover { opacity: 0.8; } .section-{{ section.id }} .home-hero__arrow--left { left: -22px; } .section-{{ section.id }} .home-hero__arrow--right { right: -22px; } .section-{{ section.id }} .home-hero__arrow .svg-wrapper { width: 20px; height: 20px; color: #ffffff; } .section-{{ section.id }} .home-hero__arrow--left .svg-wrapper { transform: rotate(0deg); } .section-{{ section.id }} .home-hero__arrow--right .svg-wrapper { transform: scaleX(-1); } .section-{{ section.id }} .home-hero__dots { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; align-items: center; gap: 1rem; } .section-{{ section.id }} .home-hero__dots .slideshow__control-wrapper { display: flex; align-items: center; gap: 1rem; } .section-{{ section.id }} .slider-counter__link--dots { width: 12px; height: 12px; border-radius: 50%; background: #ffffff; border: none; cursor: pointer; padding: 0; transition: background 0.3s ease; margin: 0; } .section-{{ section.id }} .slider-counter__link--dots.is-active { background: {{ section.settings.button_color }}; } .section-{{ section.id }} .slider-counter__link--dots:hover:not(.is-active) { background: rgba(255, 255, 255, 0.7); } .section-{{ section.id }} .slider-counter__link--dots .dot { display: none; } .section-{{ section.id }} .global-container { width: 100%; max-width: 100%; margin: 0; padding-left: var(--gutter, 16px); padding-right: var(--gutter, 16px); } @media (max-width: 749px) { .section-{{ section.id }} .hero-slide__text-wrapper { padding: {{ section.settings.content_padding_top_mobile }}px {{ section.settings.content_padding_sides_mobile }}px {{ section.settings.content_padding_bottom_mobile }}px; } .section-{{ section.id }} .hero-slide__text { padding: 1.5rem; } .section-{{ section.id }} .hero-slide__eyebrow { font-size: {{ section.settings.eyebrow_font_size_mobile }}px; } .section-{{ section.id }} .hero-slide__paragraph { font-size: {{ section.settings.paragraph_font_size_mobile }}px; } .section-{{ section.id }} .home-hero__arrow { width: 36px; height: 36px; } .section-{{ section.id }} .home-hero__arrow--left { left: -18px; } .section-{{ section.id }} .home-hero__arrow--right { right: -18px; } .section-{{ section.id }} .home-hero__dots { bottom: 1rem; } }
{% endstyle %}

{%- comment -%}
=== JavaScript (scoped) ===
{%- endcomment -%}
<script>
(function() {
  const root = document.querySelector('.section-{{ section.id }}');
  if(!root) return;

  const slider = root.querySelector('#HomeHero-{{ section.id }}');
  const slides = root.querySelectorAll('.home-hero__slide');
  const prevButton = root.querySelector('.slider-button--prev');
  const nextButton = root.querySelector('.slider-button--next');
  const dots = root.querySelectorAll('.slider-counter__link--dots');
  let currentSlide = 0;
  let autoplayInterval = null;

  if (!slider || slides.length === 0) return;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.add('is-active');
        slide.setAttribute('tabindex', '0');
      } else {
        slide.classList.remove('is-active');
        slide.setAttribute('tabindex', '-1');
      }
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
    });

    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % slides.length;
    showSlide(next);
  }

  function prevSlide() {
    const prev = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(prev);
  }

  if (prevButton) {
    prevButton.addEventListener('click', prevSlide);
  }

  if (nextButton) {
    nextButton.addEventListener('click', nextSlide);
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => showSlide(index));
  });

  // Autoplay
  const autoplayEnabled = slider.dataset.autoplay === 'true';
  const autoplaySpeed = parseInt(slider.dataset.speed) * 1000 || 5000;

  if (autoplayEnabled && slides.length > 1) {
    function startAutoplay() {
      autoplayInterval = setInterval(nextSlide, autoplaySpeed);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    const autoplayButton = root.querySelector('.slideshow__autoplay');
    if (autoplayButton) {
      let isPaused = false;
      autoplayButton.addEventListener('click', () => {
        isPaused = !isPaused;
        autoplayButton.classList.toggle('slideshow__autoplay--paused', isPaused);
        if (isPaused) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });
    }

    // Pause on hover
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', () => {
      if (!root.querySelector('.slideshow__autoplay--paused')) {
        startAutoplay();
      }
    });

    startAutoplay();
  }

  // Initialize first slide
  showSlide(0);

  // Keyboard navigation
  root.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      prevSlide();
    } else if (e.key === 'ArrowRight') {
      nextSlide();
    }
  });
})();
</script>

